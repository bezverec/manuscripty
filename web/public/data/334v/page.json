["f334v_l047"],"bbox":[605,1953,109,112],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/334v/f334v_l047.webp","raw_htr":{"catmus":"iii.","medusa":"dum"},"words":[],"flags":["small_fragment"],"note":null,"hit_token_limit":false}],"passages":[{"id":"f334v_p01","title":"Památka živých: úvod a přímluvy","line_ids":["f334v_l001","f334v_l002","f334v_l003","f334v_l004","f334v_l005","f334v_l006","f334v_l007","f334v_l008","f334v_l009","f334v_l010","f334v_l011","f334v_l012","f334v_l013","f334v_l014","f334v_l015"],"latin":"⟦…⟧. Memoria vivorum. Mei ac ⟦parentum?⟧ meorum. Omnium benefactorum meorum et omnium consanguineorum meorum, in spiritualibus et temporalibus. Omnium michi commissorum, in generali et speciali. Omnium sacerdotum et ecclesie katholice administratorum.","czech":"⟦…⟧. Památka živých. Mne a mých ⟦rodičů?⟧. Všech mých dobrodinců a všech mých příbuzných, v duchovních i časných věcech. Všech mně svěřených, obecně i jednotlivě. Všech kněží a správců katolické církve.","notes":"Samostatná nativní četba a porovnání obou úplných raw; označené nejistoty ponechány.","operations":[]},{"id":"f334v_p02","title":"Závěr přímluv za živé","line_ids":["f334v_l016","f334v_l017","f334v_l018","f334v_l019","f334v_l020","f334v_l021","f334v_l022","f334v_l023","f334v_l024","f334v_l025","f334v_l026","f334v_l027"],"latin":"Omnium inimicorum ac debitorum meorum, ad dimissionem. Omnium hereticorum et schismaticorum, ad ⟦conversionem?⟧. Omnium ⟦…⟧ fidelium vivorum pro quibus tu scis et vis me velle et debere orare.","czech":"Všech mých nepřátel a dlužníků, k odpuštění. Všech heretiků a schismatiků, k ⟦obrácení?⟧. Všech ⟦…⟧ žijících věrných, za které víš a chceš, abych se chtěl a měl modlit.","notes":"Samostatná nativní četba a porovnání obou úplných raw; označené nejistoty ponechány.","operations":[]},{"id":"f334v_p03","title":"Památka zemřelých: příbuzní a svěřené osoby","line_ids":["f334v_l028","f334v_l029","f334v_l030","f334v_l031","f334v_l032","f334v_l033","f334v_l034","f334v_l035","f334v_l036"],"latin":"Defunctorum. Omnium consanguineorum meorum defunctorum. Omnium benefactorum meorum et quorum ⟦patrum vel avorum seu?⟧ ⟦…⟧. Omnium michi commissorum, in generali et speciali. Omnium ⟦…⟧ sacramenta ecclesie administratorum ⟦…⟧.","czech":"Zemřelých. Všech mých zemřelých příbuzných. Všech mých dobrodinců a těch, jejichž ⟦otcové nebo dědové či?⟧ ⟦…⟧. Všech mně svěřených, obecně i jednotlivě. Všech ⟦…⟧ správců svátostí církve ⟦…⟧.","notes":"Samostatná nativní četba a porovnání obou úplných raw; označené nejistoty ponechány.","operations":[]},{"id":"f334v_p04","title":"Závěr přímluv za zemřelé","line_ids":["f334v_l037","f334v_l038","f334v_l039","f334v_l040","f334v_l041","f334v_l042","f334v_l043","f334v_l044","f334v_l045","f334v_l046","f334v_l047"],"latin":"Omnium animarum improvisa morte ⟦privatorum?⟧, in ecclesia militante. Omnium animarum quarum specialem memoriam non ⟦…⟧. Omnium animarum que in occasione mei in purgatorio puniuntur. Omnium fidelium defunctorum pro quibus tu scis et vis me velle et debere orare. ⟦…⟧.","czech":"Všech duší ⟦zbavených života?⟧ náhlou smrtí, v bojující církvi. Všech duší, jejichž zvláštní památku ⟦…⟧. Všech duší, které jsou mou vinou trestány v očistci. Všech věrných zemřelých, za které víš a chceš, abych se chtěl a měl modlit. ⟦…⟧.","notes":"Samostatná nativní četba a porovnání obou úplných raw; označené nejistoty ponechány.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/334v.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/334v/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0334V.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/334v/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/334v/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/334v/reconstruction.tei.xml"},{"name":"Latin