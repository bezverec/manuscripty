ids":["f78v_l089"],"bbox":[3456,4985,472,161],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/78v/f78v_l089.webp","raw_htr":{"catmus":"Ad hãc","medusa":"Ad hanc"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f78v_l090","source_segment_ids":["f78v_l090"],"bbox":[2496,5082,1408,164],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/78v/f78v_l090.webp","raw_htr":{"catmus":"sciã nos oes tene̾ debenia","medusa":"scilicet nos omnes tenere debemus"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f78v_l091","source_segment_ids":["f78v_l091"],"bbox":[2467,5202,1540,187],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/78v/f78v_l091.webp","raw_htr":{"catmus":"et dññ sequo faciẽdo suã dectua","medusa":"et dominum sequi faciendo suam doctrinam"},"words":[],"flags":[],"note":null,"hit_token_limit":false}],"passages":[{"id":"f78v_p01","title":"Ochrana Mariiny pověsti","line_ids":["f78v_l001","f78v_l002","f78v_l003","f78v_l004","f78v_l005","f78v_l006","f78v_l007","f78v_l008"],"latin":"Et de ea malum dixissent, quia ipsi infideles non credidissent quod ipsa de Spiritu sancto concepisset. Dixissent Iudaei: Ioseph Mariam non dimisisset si non malum signum ab ea cognovisset. Et sic habuissent Mariam suspectam et odiosam.","czech":"A mluvili by o ní zle, protože ti nevěřící by neuvěřili, že počala z Ducha svatého. Židé by řekli: Josef by Marii neopustil, kdyby u ní nezpozoroval špatné znamení. Tak by Marii považovali za podezřelou a nenáviděli ji.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p02","title":"Josef zbavený pochybností","line_ids":["f78v_l009","f78v_l010","f78v_l011","f78v_l012"],"latin":"Angelus Domini etiam ideo ad ipsum venit quia voluit ipsum Ioseph dubitantem ab omni dubio et incredulitate liberare.","czech":"Anděl Páně k němu přišel také proto, že chtěl pochybujícího Josefa osvobodit od všech pochybností a nevíry.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p03","title":"Proč anděl přišel až po početí","line_ids":["f78v_l013","f78v_l014","f78v_l015","f78v_l016","f78v_l017","f78v_l018","f78v_l019","f78v_l020","f78v_l021","f78v_l022","f78v_l023","f78v_l024"],"latin":"Secunda quaestio: quare angelus Domini non apparuit Ioseph ante conceptionem sed post? Sunt tres causae. Prima: si ei ante virginis conceptionem apparuisset et haec omnia recitasset, forte non credidisset quod hoc possit fieri; et tunc ab angelo graviter plagatus fuisset. Sicut enim Zachariae factum est quod verbis angeli credere noluit: mutus factus est usque in diem nativitatis filii sui. Et forte ⟦hic?⟧ fuisset factum.","czech":"Druhá otázka: proč se anděl Páně Josefovi neukázal před početím, nýbrž až potom? Jsou tři důvody. První: kdyby se mu ukázal před početím panny a všechno mu vyložil, možná by neuvěřil, že se to může stát; pak by jej anděl těžce postihl. Tak se totiž stalo Zachariášovi, který nechtěl uvěřit andělovým slovům: oněměl až do dne narození svého syna. A snad by se tak stalo ⟦i zde?⟧.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p04","title":"Známka dobrého anděla","line_ids":["f78v_l025","f78v_l026","f78v_l027","f78v_l028","f78v_l029","f78v_l030","f78v_l031","f78v_l032","f78v_l033"],"latin":"⟦Secunda causa?⟧: ideo noluit ei ante conceptionem apparere, ut Ioseph cognosceret quod iste angelus esset bonus, a Deo missus. Quasi diceret ad eum: Ioseph, noli timere nec dubitare; cor tuum et propositum quod habes intelligo. Ideo sum bonus et non malus angelus, quia secreta cordium et futura et ⟦…⟧ ipse intelligere non potest.","czech":"⟦Druhý důvod?⟧: proto se mu nechtěl ukázat před početím, aby Josef poznal, že tento anděl je dobrý a poslaný od Boha. Jako by mu říkal: Josefe, neboj se a nepochybuj; rozumím tvému srdci a úmyslu, který máš. Proto jsem dobrý, a ne zlý anděl; ten totiž nemůže rozumět tajemstvím srdcí, budoucím věcem a ⟦…⟧.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p05","title":"Úcta k panně","line_ids":["f78v_l034","f78v_l035","f78v_l036","f78v_l037","f78v_l038","f78v_l039","f78v_l040","f78v_l041","f78v_l042","f78v_l043","f78v_l044","f78v_l045","f78v_l046"],"latin":"Tertia causa est quia Deus voluit matrem suam custodire et in omni honore et in reverentia habere eam. Quasi diceret angelus: cessa, Ioseph, a dubio tuo. Haec enim virgo casta concepit, non de virili semine sed de Spiritu sancto. Etiam ideo ut cognosceret quod virginem in honore magis haberet quam prius. Quasi diceret angelus: noli hanc virginem ⟦de servitio modicum?⟧; sed haec regina est et mater angelorum et hominum.","czech":"Třetím důvodem je, že Bůh chtěl chránit svou matku a mít ji v plné úctě a vážnosti. Jako by anděl říkal: Josefe, zanech svých pochybností. Tato čistá panna totiž počala, nikoli z mužského semene, nýbrž z Ducha svatého. Také proto, aby poznal, že má pannu ctít více než dříve. Jako by anděl říkal: ⟦nepovažuj tuto pannu za málo významnou služebnici?⟧; vždyť je královnou a matkou andělů i lidí.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p06","title":"Proč byl Josef poučen","line_ids":["f78v_l047","f78v_l048","f78v_l049","f78v_l050","f78v_l051"],"latin":"Et ideo ei apparuit ut eum informaret quomodo hanc virginem magis honorare et diligere debet quam prius. Tertia quaestio est: quare angelus Domini non apparuit virgini post conceptionem, sed ante?","czech":"A proto se mu ukázal, aby jej poučil, jak má tuto pannu více ctít a milovat než dříve. Třetí otázka zní: proč se anděl Páně neukázal panně po početí, nýbrž před ním?","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p07","title":"Marie poučená předem","line_ids":["f78v_l052","f78v_l053","f78v_l054","f78v_l055","f78v_l056","f78v_l057","f78v_l058","f78v_l059","f78v_l060","f78v_l061","f78v_l062","f78v_l063","f78v_l064","f78v_l065"],"latin":"⟦Responsio?⟧: ne haec virgo turbata et angustata fuisset in conceptione, quia ignorasset unde concepisset, vel ex Deo vel ex diabolo vel ex homine; et inter se cogitasset: O quid faciam? Quid concipere debeam? Magnum enim ventrem habeo, virum autem non cognovi. Unde ergo in hoc? Ideo bene decuit quod angelus ante conceptionem ad eam veniret et diceret ei: noli timere; concipies in utero, non de virili semine sed virtute Spiritus sancti. Sic enim erit tecum sicut loquor.","czech":"⟦Odpověď?⟧: aby tato panna nebyla při početí rozrušená a úzkostná, protože by nevěděla, odkud počala: zda z Boha, z ďábla či z člověka. V duchu by si říkala: Co mám dělat? Co mám počít? Mám totiž velké břicho, ale muže jsem nepoznala. Odkud tedy tato věc? Proto bylo velmi příhodné, aby k ní anděl přišel před početím a řekl jí: neboj se; počneš v lůně, nikoli z mužského semene, nýbrž mocí Ducha svatého. Tak se ti totiž stane, jak říkám.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p08","title":"Radostné početí a Jakubův sen","line_ids":["f78v_l066","f78v_l067","f78v_l068","f78v_l069","f78v_l070","f78v_l071","f78v_l072","f78v_l073","f78v_l074","f78v_l075","f78v_l076","f78v_l077","f78v_l078","f78v_l079"],"latin":"Non decuit quod mater supremi regis cum dolore, tristitia et angustia filium eius concepisset; sed cum omni gaudio eum concepit. Sequitur: apparuit in somnis et dicens. Haec apparitio est figurata libro Genesis XXVIII, cum angelus Iacob patriarchae apparuit in somno, sic dormivit super lapidem. Et ibi vidit scalam et summitatem eius usque ad caelos attingentem; et Dominus fuit in scala, et angeli descendunt et ascendunt.","czech":"Neslušelo se, aby matka nejvyššího krále počala jeho syna s bolestí, smutkem a úzkostí; počala jej však s veškerou radostí. Následuje: ukázal se ve snu a řekl. Toto zjevení je předobrazeno v 28. kapitole knihy Genesis, kdy se anděl ukázal patriarchovi Jakubovi ve spánku, když spal na kameni. Viděl tam žebřík, jehož vrchol sahal až do nebes; Pán byl na žebříku a andělé sestupovali a vystupovali.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f78v_p09","title":"Kristus jako žebřík do nebe","line_ids":["f78v_l080","f78v_l081","f78v_l082","f78v_l083","f78v_l084","f78v_l085","f78v_l086","f78v_l087","f78v_l088","f78v_l089","f78v_l090","f78v_l091"],"latin":"Haec alta scala est Deus gloriosus, qui secundum divinitatem fuit super omnes caelos elevatus et per humanitatem nobiscum in terris conversatus. Ipse enim est scala per quam omnes ascendere debemus. In ipsa enim ascendit cum humanitate et divinitate in regnum caelorum, nobis viam suam praeparans in die suae ascensionis. Ad hanc scalam nos omnes tenere debemus et Dominum sequi, faciendo suam doctrinam.","czech":"Tímto vysokým žebříkem je slavný Bůh, který byl podle božství vyvýšen nad všechna nebesa a skrze lidství pobýval s námi na zemi. On je žebřík, po němž máme všichni vystoupit. V něm totiž vystoupil s lidstvím i božstvím do nebeského království a v den svého nanebevstoupení nám připravil svou cestu. Všichni se máme tohoto žebříku držet a následovat Pána uskutečňováním jeho učení.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/78v.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/78v/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0078V.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/78v/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/78v/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/78v/reconstruction.tei.xml"},{"name":"Latinská rekonstrukce TXT","href":"data/78v/reconstruction.la.txt"},{"name":"Český překlad TXT","href":"data/78v/translation.cs.txt"}],"document_id":"vkol-m-ii-220","document_uri":"https://rukopisy.digitalizaty.cz/rukopisy/vkol-m-ii-220","repository":{"name":"Vědecká knihovna v Olomouci","uri":"https://www.vkol.cz/","settlement":"Olomouc","country":"Česko"}}
