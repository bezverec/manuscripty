  "passages": [
    {
      "id": "u_92v_001",
      "title": "Úsek 1",
      "line_ids": [
        "f92v_l001",
        "f92v_l002",
        "f92v_l003",
        "f92v_l004",
        "f92v_l005"
      ],
      "latin": "cooperies secrete et firme devotionis et sedebis ibi iuxta sepulchrum et recommendabis me et te sibi in animo eiusdem Domini nostri Ihesu Christi qui cum Deo patre [...]",
      "czech": "[Pokračování z 92r:] zahalíš [tělo?] tichou a pevnou oddaností, usedneš u hrobu a v duchu témuž našemu Pánu Ježíši Kristu doporučíš mě i sebe. On s Bohem Otcem… [doxologie nedokončena].",
      "notes": "Cooperies čtu ve významu pokryješ/zahalíš, nikoli modelové cooperes; začátek je závislý na 92r a vazba devotionis zůstává neúplná. · Doxologie je ponechána nedokončená, bez domyšleného běžného závěru.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_002",
      "title": "Úsek 2",
      "line_ids": [
        "f92v_l006",
        "f92v_l007",
        "f92v_l008",
        "f92v_l009"
      ],
      "latin": "Explicit contemplatio devotissima Sancti Bernhardi Abbatis super septem horas canonicas de passione Domini nostri Ihesu Christi salvatoris.",
      "czech": "Končí nejzbožnější rozjímání svatého Bernarda opata o sedmi kanonických hodinách a o utrpení našeho Pána Ježíše Krista Spasitele. Jde o připsání uvedené v rukopisu.",
      "notes": "Bernardi je obrazově podpořená expanze. Připsání světci není důkaz skutečného autorství.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_003",
      "title": "Úsek 3",
      "line_ids": [
        "f92v_l010",
        "f92v_l011",
        "f92v_l012",
        "f92v_l013"
      ],
      "latin": "[...hat?] hoc totum in fine da michi potum. Nomen scriptoris si tu cognoscere velis, Hi[?] tibi sit primum co[...].",
      "czech": "[…] toto všechno; na konci mi dej nápoj. Chceš-li poznat jméno písaře, ať je pro tebe první Hi[?] co[…] [nápověda nerozluštěna].",
      "notes": "Počáteční sloveso nebo zkratku nepodařilo se bezpečně přečíst; in fine da michi potum je čitelné. Jde patrně o písařskou formuli, bez identifikace písaře. · Nápověda k nomen scriptoris je neúplná a nejistá. Žádné konkrétní jméno z ní nevyvozuji.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_004",
      "title": "Úsek 4",
      "line_ids": [
        "f92v_l014",
        "f92v_l015",
        "f92v_l016",
        "f92v_l017"
      ],
      "latin": "[nota addita: [...] compungitur cor[?] [...] supplica[...]] [nota addita: Amore] [nota addita: cum [...] propter Deum [...] profitetur delicta [...]] [nota addita: Et cum multis sit malis, scit eis implicatum, fugit ad Dominum [...]]",
      "czech": "Drobné schéma, větev ‚Láskou‘: […] srdce je zasaženo […] prosí […]; pro Boha […] vyznává provinění […]. Protože vězí v mnohých zlých věcech a ví o svém zapletení, utíká k Pánu […]. Čtení drobných zkratek je nejisté.",
      "notes": "Malé schéma má jinou velikost a rozvržení; tento segment zachycuje jen část větve, část se opakuje při okraji dalších výřezů. Nejisté zkratky neexpandovány násilně. · Řádky 14–32 náležejí drobnému rozvětvenému přehledu, nikoli plynulému hlavnímu textu. Větné vazby a pořadí jsou nejisté.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_005",
      "title": "Úsek 5",
      "line_ids": [
        "f92v_l018",
        "f92v_l019"
      ],
      "latin": "[nota addita: Dolore, cum dolet se Deum offendisse, ingemiscit[?] [...] parum profecisse] [nota addita: tam [...] esse, in tantum displicere]",
      "czech": "Větev ‚Bolestí‘: když se rmoutí, že urazil Boha, vzdychá […] že málo pokročil […], a tolik se mu nelíbí […] [fragmentární čtení].",
      "notes": "",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_006",
      "title": "Úsek 6",
      "line_ids": [
        "f92v_l020",
        "f92v_l021"
      ],
      "latin": "[nota addita: Desiderio, cum suspirat ad gratias ampliores [...] ut] [nota addita: ad [...] et Dominum suum vel Christum [...] ]",
      "czech": "Větev ‚Touhou‘: když dychtí po hojnější milosti […] a po […] svém Pánu či Kristu […] [závěr nejistý].",
      "notes": "",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_92v_007",
