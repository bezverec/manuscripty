      ],
      "latin": "[fragmentum: ornamentum, non textus] [fragmentum: ornamentum, non textus] [fragmentum: ornamentum, non textus] [fragmentum: ornamentum, non textus]",
      "czech": "[Čtyři falešně segmentované úseky ozdobného rámu; nejde o čitelný souvislý text.]",
      "notes": "Segmenty1–4 zachycují části ornamentálního rámu. HTR jim přisuzuje náhodná písmena/čísla.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_FS_002",
      "title": "Úsek 2",
      "line_ids": [
        "fFS_l005",
        "fFS_l006"
      ],
      "latin": "Paullum, siste, viator.",
      "czech": "Na chvilku se zastav, poutníku.",
      "notes": "",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_FS_003",
      "title": "Úsek 3",
      "line_ids": [
        "fFS_l007",
        "fFS_l008",
        "fFS_l009",
        "fFS_l010"
      ],
      "latin": "Hic situs ille, inlustris et magnificus, Ioach[imus?] Hauguuic, [Marcomannorum?] olim caput,",
      "czech": "Zde je pochován onen slavný a vznešený Joach[im?] Hauguuic, kdysi hlava [„Marcom.“ — rozvedení nejisté].",
      "notes": "Zachováno latinizované grafické Hauguuic (na tisku HAVG VVIC); příjmení není automaticky modernizováno ani autoritně identifikováno. Ioach. je předběžně rozvedeno na Ioachimus. · MARCOM. nerozvíjím jako bezpečně určený titul. Marcomannorum je označená hypotéza zkratky; český překlad ji ponechává otevřenou.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_FS_004",
      "title": "Úsek 4",
      "line_ids": [
        "fFS_l011",
        "fFS_l012",
        "fFS_l013",
        "fFS_l014"
      ],
      "latin": "bonorum amor, suorum sol, catholicae pietatis virtutumque exemplum.",
      "czech": "Milovaný dobrými lidmi, slunce svých blízkých, příklad katolické zbožnosti a ctností.",
      "notes": "",
      "operations": [],
      "language": "la"
    },
