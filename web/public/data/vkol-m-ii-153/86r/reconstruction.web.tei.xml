299 1603,3270 1601,3270 1322,3270 1321,3270 1319,3270 1233,3299 1167,3270 1165,3270 1089,3270 1088,3270 1086,3270 1024,3304 937,3304 894,3283 893,3283 891,3283 889,3283 887,3283 867,3297 776,3304 778,3367" xml:id="z_f86r_l019"/><zone ulx="776" uly="3415" lrx="2213" lry="3554" points="778,3499 781,3554 798,3543 833,3552 834,3552 836,3552 838,3552 839,3552 860,3538 949,3552 951,3552 1141,3540 1197,3552 1199,3552 1201,3552 1202,3552 1221,3538 1264,3550 1266,3550 1268,3550 1399,3542 1415,3552 1416,3552 1418,3552 1420,3554 1516,3554 1516,3552 1518,3552 1547,3540 1577,3552 1579,3552 1581,3554 1656,3554 1656,3552 1658,3552 1660,3552 1680,3538 1742,3537 1923,3537 1966,3547 1968,3547 1970,3547 2211,3538 2213,3501 2209,3439 1935,3427 1934,3427 1932,3427 1906,3439 1815,3439 1740,3418 1738,3418 1737,3418 1678,3429 1631,3420 1629,3420 1627,3420 1579,3432 1545,3415 1543,3415 1456,3415 1454,3415 1452,3415 1428,3427 1413,3415 1411,3415 1410,3415 1338,3415 1336,3415 1334,3415 1283,3434 1252,3424 1250,3424 1249,3424 1247,3424 1211,3434 1146,3424 1144,3424 1143,3424 1141,3424 1117,3441 995,3441 958,3415 956,3415 954,3415 901,3415 899,3415 898,3415 896,3415 875,3429 834,3415 833,3415 831,3415 776,3415 778,3499" xml:id="z_f86r_l020"/></surface></facsimile><text><body><div type="raw_htr" subtype="catmus"><ab type="raw_unreviewed"><lb facs="#z_f86r_l001" xml:id="catmus_f86r_l001"/><seg type="raw_unreviewed">et ab insidiis ĩ uucom meoru</seg><lb facs="#z_f86r_l002" xml:id="catmus_f86r_l002"/><seg type="raw_unreviewed">uisibihũ ⁊ ĩ uiloum De que</seg><lb facs="#z_f86r_l003" xml:id="catmus_f86r_l003"/><seg type="raw_unreviewed">dilco filio tuo recõmenda sicud</seg><lb facs="#z_f86r_l004" xml:id="catmus_f86r_l004"/><seg type="raw_unreviewed">stans iux crucem abeodeu frlio</seg><lb facs="#z_f86r_l005" xml:id="catmus_f86r_l005"/><seg type="raw_unreviewed">tno . B̾to Iohe erngelista es di-</seg><lb facs="#z_f86r_l006" xml:id="catmus_f86r_l006"/><seg type="raw_unreviewed">ligontissime comendata Et in-</seg><lb facs="#z_f86r_l007" xml:id="catmus_f86r_l007"/><seg type="raw_unreviewed">petra michi aħ eodem filio tuodi</seg><lb facs="#z_f86r_l008" xml:id="catmus_f86r_l008"/><seg type="raw_unreviewed">ectissimo ut cõmendat michi se</seg><lb facs="#z_f86r_l009" xml:id="catmus_f86r_l009"/><seg type="raw_unreviewed">iũ suaꝵ assistrice sapiam ut</seg><lb facs="#z_f86r_l010" xml:id="catmus_f86r_l010"/><seg type="raw_unreviewed">mecũ sit ⁊ mecu laboret ut</seg><lb facs="#z_f86r_l011" xml:id="catmus_f86r_l011"/><seg type="raw_unreviewed">sciam ꝙͥ acceꝑtũ sit cora es ortpe</seg><lb facs="#z_f86r_l012" xml:id="catmus_f86r_l012"/><seg type="raw_unreviewed">Et det ẜ̾mone in ob men beneso</seg><lb facs="#z_f86r_l013" xml:id="catmus_f86r_l013"/><seg type="raw_unreviewed">nante ⁊ rtiint efficaciter ⁊ meo-</seg><lb facs="#z_f86r_l014" xml:id="catmus_f86r_l014"/><seg type="raw_unreviewed">riter ⁊ fatude elequia dei ad lande</seg><lb facs="#z_f86r_l015" xml:id="catmus_f86r_l015"/><seg type="raw_unreviewed">⁊ glam sua ⁊ad utilitate omi</seg><lb facs="#z_f86r_l016" xml:id="catmus_f86r_l016"/><seg type="raw_unreviewed">sdelm̃ ualeam pnucture Pxpi</seg><lb facs="#z_f86r_l017" xml:id="catmus_f86r_l017"/><seg type="raw_unreviewed">dilci ⁊ uiucur filu tuu Em po-</seg><lb facs="#z_f86r_l018" xml:id="catmus_f86r_l018"/><seg type="raw_unreviewed">tentissima sua u̾tute mortem ui</seg><lb facs="#z_f86r_l019" xml:id="catmus_f86r_l019"/><seg type="raw_unreviewed">at inferuũ descendit ⁊ eiꝰ por</seg><lb facs="#z_f86r_l020" xml:id="catmus_f86r_l020"/><seg type="raw_unreviewed">tas ex enudoffregit . Auien</seg></ab></div><div type="raw_htr" subtype="medusa"><ab type="raw_unreviewed"><lb facs="#z_f86r_l001" xml:id="medusa_f86r_l001"/><seg type="raw_unreviewed">et ab insidiis inimicorum meorum</seg><lb facs="#z_f86r_l002" xml:id="medusa_f86r_l002"/><seg type="raw_unreviewed">visibilium et in visibilibus Me que</seg><lb facs="#z_f86r_l003" xml:id="medusa_f86r_l003"/><seg type="raw_unreviewed">dilecto filio tuo recommenda sicut</seg><lb facs="#z_f86r_l004" xml:id="medusa_f86r_l004"/><seg type="raw_unreviewed">stans iuxta crucem ab eodem filio</seg><lb facs="#z_f86r_l005" xml:id="medusa_f86r_l005"/><seg type="raw_unreviewed">tio . Stõ Ioh̄e ewͣngelista es di</seg><lb facs="#z_f86r_l006" xml:id="medusa_f86r_l006"/><seg type="raw_unreviewed">ligentissime commendata Et in</seg><lb facs="#z_f86r_l007" xml:id="medusa_f86r_l007"/><seg type="raw_unreviewed">petra michi ab eodem filio tuo di</seg><lb facs="#z_f86r_l008" xml:id="medusa_f86r_l008"/><seg type="raw_unreviewed">lectissimo / ut commendat michi se</seg><lb facs="#z_f86r_l009" xml:id="medusa_f86r_l009"/><seg type="raw_unreviewed">dñi suarum assisticem sapientiam ut</seg><lb facs="#z_f86r_l010" xml:id="medusa_f86r_l010"/><seg type="raw_unreviewed">mecum sit et mecum laboret ut</seg><lb facs="#z_f86r_l011" xml:id="medusa_f86r_l011"/><seg type="raw_unreviewed">Sciam ꝙ acceptum sit coram eo oĩ tpe</seg><lb facs="#z_f86r_l012" xml:id="medusa_f86r_l012"/><seg type="raw_unreviewed">Ut det sermonẽ in os meũ beneso</seg><lb facs="#z_f86r_l013" xml:id="medusa_f86r_l013"/><seg type="raw_unreviewed">nantẽ ⁊ rtm̃ ut efficaciter ⁊ meo</seg><lb facs="#z_f86r_l014" xml:id="medusa_f86r_l014"/><seg type="raw_unreviewed">riter et fatunde eloquia dei ad laudem</seg><lb facs="#z_f86r_l015" xml:id="medusa_f86r_l015"/><seg type="raw_unreviewed">et gloriam suam / et ad utilitatem omnium</seg><lb facs="#z_f86r_l016" xml:id="medusa_f86r_l016"/><seg type="raw_unreviewed">fidelium valeam pronunciare per ipsum</seg><lb facs="#z_f86r_l017" xml:id="medusa_f86r_l017"/><seg type="raw_unreviewed">dilectum et unicum filium tuum. Qui po</seg><lb facs="#z_f86r_l018" xml:id="medusa_f86r_l018"/><seg type="raw_unreviewed">tentissima sua u̾tute mortem ui</seg><lb facs="#z_f86r_l019" xml:id="medusa_f86r_l019"/><seg type="raw_unreviewed">cit inferum descendit et eiꝰ por</seg><lb facs="#z_f86r_l020" xml:id="medusa_f86r_l020"/><seg type="raw_unreviewed">tas ex eundo fregit .</seg></ab></div><div type="reconstruction" subtype="AI_proposed"><ab><lb facs="#z_f86r_l001" xml:id="r_f86r_l001"/><seg type="reconstruction_proposed">et ab insidiis inimicorum meorum</seg><lb facs="#z_f86r_l002" xml:id="r_f86r_l002"/><seg type="reconstruction_proposed">visibilium et invisibilium. Me quoque</seg><lb facs="#z_f86r_l003" xml:id="r_f86r_l003"/><seg type="reconstruction_proposed">dilecto filio tuo recommenda, sicut</seg><lb facs="#z_f86r_l004" xml:id="r_f86r_l004"/><seg type="reconstruction_proposed">stans iuxta crucem ab eodem filio</seg><lb facs="#z_f86r_l005" xml:id="r_f86r_l005"/><seg type="reconstruction_proposed">tuo beato Iohanni evangeliste es di-</seg><lb facs="#z_f86r_l006" xml:id="r_f86r_l006"/><seg type="reconstruction_proposed">ligentissime commendata. Et im-</seg><lb facs="#z_f86r_l007" xml:id="r_f86r_l007"/><seg type="reconstruction_proposed">petra michi ab eodem filio tuo di-</seg><lb facs="#z_f86r_l008" xml:id="r_f86r_l008"/><seg type="reconstruction_proposed">lectissimo, ut commendet michi se-</seg><lb facs="#z_f86r_l009" xml:id="r_f86r_l009"/><seg type="reconstruction_proposed">dium suarum assistricem sapienciam, ut</seg><lb facs="#z_f86r_l010" xml:id="r_f86r_l010"/><seg type="reconstruction_proposed">mecum sit et mecum laboret, ut</seg><lb facs="#z_f86r_l011" xml:id="r_f86r_l011"/><seg type="reconstruction_proposed">sciam quod acceptum sit coram eo omni tempore.</seg><lb facs="#z_f86r_l012" xml:id="r_f86r_l012"/><seg type="reconstruction_proposed">Ut det sermonem in os meum bene so-</seg><lb facs="#z_f86r_l013" xml:id="r_f86r_l013"/><seg type="reconstruction_proposed">nantem et rectum, ut efficaciter et memo-</seg><lb facs="#z_f86r_l014" xml:id="r_f86r_l014"/><seg type="reconstruction_proposed">riter et facunde eloquia Dei ad laudem</seg><lb facs="#z_f86r_l015" xml:id="r_f86r_l015"/><seg type="reconstruction_proposed">et gloriam suam et ad utilitatem omnium</seg><lb facs="#z_f86r_l016" xml:id="r_f86r_l016"/><seg type="reconstruction_proposed">fidelium valeam pronunciare per ipsum</seg><lb facs="#z_f86r_l017" xml:id="r_f86r_l017"/><seg type="reconstruction_proposed">dilectum et unicum filium tuum, qui po-</seg><lb facs="#z_f86r_l018" xml:id="r_f86r_l018"/><seg type="reconstruction_proposed">tentissima sua virtute mortem vi-</seg><lb facs="#z_f86r_l019" xml:id="r_f86r_l019"/><seg type="reconstruction_proposed">cit, infernum descendit et eius por-</seg><lb facs="#z_f86r_l020" xml:id="r_f86r_l020"/><seg type="reconstruction_proposed">tas exeundo fregit. Amen.</seg></ab><note type="editorial" target="#r_f86r_l005" xml:lang="cs">Rozvíjím zkratku Bto jako beato, nikoli modelové sancto.</note><note type="editorial" target="#r_f86r_l008" xml:lang="cs">Slovo se-dium přes hranici řádků; sapienciam vyloženo jako moudrost stojící u Božích sídel.</note><note type="editorial" target="#r_f86r_l009" xml:lang="cs">Assistricem zachovává viditelnou podobu slova.</note><note type="editorial" target="#r_f86r_l013" xml:lang="cs">Meo- obou modelů čtu jako memo- s pokračováním riter.</note><note type="editorial" target="#r_f86r_l019" xml:lang="cs">Ponechávám rukopisné infernum descendit bez přidávání ad.</note><note type="editorial" target="#r_f86r_l020" xml:lang="cs">Amen je součástí výřezu; následuje okrasné zakončení, ne další samostatný text.</note></div><div type="translation" subtype="AI_proposed" xml:lang="cs"><p corresp="#r_f86r_l001 #r_f86r_l002 #r_f86r_l003 #r_f86r_l004 #r_f86r_l005 #r_f86r_l006" xml:id="u_86r_001">…a před úklady mých viditelných i neviditelných nepřátel. Doporuč mě také svému milovanému Synu, jako jsi ty, když jsi stála u kříže, byla týmž svým Synem s největší péčí doporučena blahoslavenému Janu evangelistovi.</p><p corresp="#r_f86r_l007 #r_f86r_l008 #r_f86r_l009 #r_f86r_l010 #r_f86r_l011" xml:id="u_86r_002">Vypros mi u téhož svého nejmilovanějšího Syna, aby mi svěřil moudrost, která stojí u jeho trůnů; ať je se mnou a se mnou pracuje, abych vždy věděl, co je před ním přijatelné.</p><p corresp="#r_f86r_l012 #r_f86r_l013 #r_f86r_l014 #r_f86r_l015 #r_f86r_l016" xml:id="u_86r_003">Ať vloží do mých úst dobře znějící a správnou řeč, abych mohl účinně, zpaměti a výmluvně hlásat Boží slova k jeho chvále a slávě i k užitku všech věřících,</p><p corresp="#r_f86r_l017 #r_f86r_l018 #r_f86r_l019 #r_f86r_l020" xml:id="u_86r_004">skrze tvého milovaného a jediného Syna, který svou nejmocnější silou přemohl smrt, sestoupil do podsvětí a při odchodu rozlomil jeho brány. Amen.</p></div></body></text></TEI>