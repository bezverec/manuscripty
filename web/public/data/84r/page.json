2192,4654,1393,137],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l089.webp","raw_htr":{"catmus":"uel ꝑ ꝑdicatoes suos q̃ hoies","medusa":"vel per predicatores suos qͥ homines"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l090","source_segment_ids":["f84r_l090"],"bbox":[2187,4738,1438,151],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l090.webp","raw_htr":{"catmus":"inscriuãt ĩ uõ dei ut cognoscãt","medusa":"instrumentum in nomine dei / ut cognoscant"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l091","source_segment_ids":["f84r_l091"],"bbox":[2187,4831,1339,143],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l091.webp","raw_htr":{"catmus":"cori uitã qntũ ꝑfrcmt in","medusa":"eorum vitam quantum proficiunt in"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l092","source_segment_ids":["f84r_l092"],"bbox":[2201,4933,1392,131],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l092.webp","raw_htr":{"catmus":"uctis et qutũ deficiut in dei","medusa":"peccatis et quantum deficiunt in dei"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l093","source_segment_ids":["f84r_l093"],"bbox":[2219,5023,1403,148],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l093.webp","raw_htr":{"catmus":"gca Et sic̃ lio aliuãt tenebs","medusa":"gra Et sic lix illuĩat teneb᷑s"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l094","source_segment_ids":["f84r_l094"],"bbox":[2216,5133,1313,122],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l094.webp","raw_htr":{"catmus":"sic y dei illiuat tenebrosa","medusa":"sic y dei illuminat tenebrosa"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f84r_l095","source_segment_ids":["f84r_l095"],"bbox":[2219,5212,1357,160],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/84r/f84r_l095.webp","raw_htr":{"catmus":"eetori corda Aciũ inf̾mos","medusa":"Petrus Corda tercium infirmos"},"words":[],"flags":[],"note":null,"hit_token_limit":false}],"passages":[{"id":"f84r_p01","title":"Vševidoucí soudce","line_ids":["f84r_l001","f84r_l002","f84r_l003","f84r_l004","f84r_l005","f84r_l006","f84r_l007","f84r_l008"],"latin":"In omni loco oculi Domini contemplantur bonos et malos. Et Ecclesiasticus: Omnia videt oculus eius. Et Boethius: Magna nobis indicta est necessitas bene vivendi. Ex quo omnia opera quae facimus vident oculi iudicis, debemus ergo nunquam mala facere, ex quo Deus omnia videt.","czech":"Na každém místě hledí oči Páně na dobré i zlé. A Ecclesiasticus: Jeho oko vidí všechno. A Boethius: Byla nám uložena veliká nutnost dobře žít. Protože oči soudce vidí všechny skutky, které konáme, nemáme tedy nikdy činit zlo, neboť Bůh vidí všechno.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p02","title":"Oči jako plamen obrácení","line_ids":["f84r_l009","f84r_l010","f84r_l011","f84r_l012","f84r_l013","f84r_l014","f84r_l015","f84r_l016","f84r_l017","f84r_l018","f84r_l019","f84r_l020","f84r_l021"],"latin":"Secundo oculi Domini sunt potentes ad convertendum peccatorem, et sunt quasi flammae. Unde Apocalypsis: Oculi eius quasi flammae ignis, et cetera. Sicut ignis incendit lignum et consumit, sic oculi Domini incendunt misericorditer in amore divino peccatores. Illo modo ab oculis Domini incensus est Zacchaeus, qui desideravit Dominum videre et non poterat. Ideo audivit a Deo: Zacchaee, festinans descende. His oculis inspexit Petrum negantem Dominum, et subito se cognovit peccasse, et exiens flevit amare. Lucae xxii.","czech":"Za druhé jsou oči Páně mocné k obrácení hříšníka a jsou jako plameny. Proto Apokalypsa: Jeho oči jsou jako plameny ohně, a tak dále. Jako oheň zapaluje a stravuje dřevo, tak oči Páně milosrdně rozněcují hříšníky v Boží lásce. Tímto způsobem byl Pánovým pohledem zapálen Zacheus, který toužil vidět Pána a nemohl. Proto od Boha uslyšel: Zachee, rychle sestup. Těmito očima pohlédl na Petra, který zapíral Pána; ten hned poznal, že zhřešil, vyšel ven a hořce plakal. Lukáš, dvacátá druhá kapitola.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p03","title":"Milosrdné oči a vzkříšení","line_ids":["f84r_l022","f84r_l023","f84r_l024","f84r_l025","f84r_l026","f84r_l027","f84r_l028","f84r_l029","f84r_l030","f84r_l031","f84r_l032","f84r_l033","f84r_l034"],"latin":"His oculis inspexit Dominus misericordia motus super filium unicum viduae, qui mortuus erat, et Dominus ait ei: Noli flere. Et accessit et tetigit loculum et ait: Adolescens, tibi dico, surge. Et surrexit. Lucae vii. His oculis inspexit dolentes sorores super Lazarum, Iohannis xi, et misertus Dominus suscitavit eum. Ecce quam potentes sunt oculi Domini! Etiam sunt misericordes, ut quemcunque inspiciunt misericordiam inveniet.","czech":"Těmito očima Pán pohlédl, pohnut milosrdenstvím, na jediného syna vdovy, který byl mrtev; Pán jí řekl: Neplač. Přistoupil, dotkl se már a řekl: Mládenče, pravím ti, vstaň. A vstal. Lukáš, sedmá kapitola. Těmito očima pohlédl na sestry truchlící nad Lazarem, Jan, jedenáctá kapitola, a Pán se slitoval a vzkřísil ho. Hle, jak mocné jsou oči Páně! Jsou také milosrdné, takže každý, na koho pohlédnou, nalezne milosrdenství.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p04","title":"Lakomec jako sokol na ďáblově ruce","line_ids":["f84r_l035","f84r_l036","f84r_l037","f84r_l038","f84r_l039","f84r_l040","f84r_l041","f84r_l042","f84r_l043","f84r_l044","f84r_l045","f84r_l046","f84r_l047","f84r_l048","f84r_l049","f84r_l050"],"latin":"Unde Petrus: Oculi Domini in pauperem respiciunt. Sic non sunt oculi avari hominis, sed semper cupidi. Unde Gregorius: Oculi hominis insatiabiles. Et talis avarus comparatur falconi. Dicit magnus Albertus quod est velox ad rapiendum omnes aves indifferenter. Sic usurarii et avari sunt falcones. Hos diabolus portat super manum suam, quia iam habet eos in potestate sua et transit in venatum cum eis, quia tales rapiunt pauperibus labores et sudores et non habent discretionem, hoc est non parcunt viduis, orphanis vel pauperibus, et cetera.","czech":"Proto Petr: Oči Páně hledí na chudého. Takové nejsou oči lakomého člověka, nýbrž jsou stále chtivé. Proto Řehoř: Oči člověka jsou nenasytné. Takový lakomec je přirovnán k sokolovi. Veliký Albert praví, že je rychlý v uchvacování všech ptáků bez rozdílu. Tak jsou lichváři a lakomci sokolové. Ďábel je nosí na své ruce, protože je už má ve své moci, a chodí s nimi na lov; takoví totiž chudým uchvacují práci i pot a nemají rozlišování, to jest nešetří vdovy, sirotky ani chudé, a tak dále.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p05","title":"Zastření očí dravce a připomínka soudu","line_ids":["f84r_l051","f84r_l052","f84r_l053","f84r_l054","f84r_l055","f84r_l056","f84r_l057","f84r_l058"],"latin":"Si autem cooperirent eorum oculos, utique non raperent. Hoc est: Si illum ante oculos eorum haberent, qui in die iudicii iudicaturus est omnes homines iuxta eorum merita, a rapina malarum divitiarum cessarent; qui ait: Mihi vindicta et ego retribuam.","czech":"Kdyby jim však zakryli oči, jistě by neloupili. To znamená: Kdyby měli před svýma očima toho, který v den soudu bude soudit všechny lidi podle jejich zásluh, přestali by ulupovat zlé bohatství; on říká: Mně náleží pomsta a já odplatím.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p06","title":"Otázka Filipovi a horliví posluchači","line_ids":["f84r_l059","f84r_l060","f84r_l061","f84r_l062","f84r_l063","f84r_l064","f84r_l065","f84r_l066","f84r_l067","f84r_l068","f84r_l069","f84r_l070","f84r_l071"],"latin":"Sequitur: Dixit ad Philippum, qui fuit oriundus de illa regione et multos habuit notos homines. Ideo dixit ad eum: Unde ememus? Interrogavit eos non quod ignoraret, sed ut ex verbis discipulorum cognosceretur magnum fore miraculum. Ecce quam ferventes fuerunt homines in audiendo verbum Dei, quod neglexerunt sumere cibum cum eis! Illi maiorem curam habuerunt de cibo spirituali ad reficiendum animam quam de cibo corporali.","czech":"Následuje: Řekl Filipovi, který pocházel z té krajiny a znal mnoho lidí. Proto mu řekl: Kde nakoupíme? Ptal se jich nikoli proto, že by nevěděl, ale aby se ze slov učedníků ukázalo, že nastane veliký zázrak. Hle, jak byli lidé horliví v poslouchání Božího slova, že si zapomněli vzít jídlo! Více se starali o duchovní pokrm k posílení duše než o tělesné jídlo.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p07","title":"Čtyři Kristovy služby a přijetí unavených","line_ids":["f84r_l072","f84r_l073","f84r_l074","f84r_l075","f84r_l076","f84r_l077","f84r_l078","f84r_l079","f84r_l080","f84r_l081","f84r_l082","f84r_l083","f84r_l084","f84r_l085","f84r_l086"],"latin":"Nota quattuor facit hic Deus: Primo fatigatos suscepit, esurientes pavit, indoctos instruit, infirmos curat. Sic spiritualiter hodie facit Dominus et omni tempore. Cum autem fatigati sumus in peccatis et amplius peccare non possumus, ita quod necesse ⟦…⟧ nos oportet dimittere, adhuc Dominus vero nos fatigatos in peccatis ex sua misericordia vult suscipere. Sic ait in Ezechiele: Revertere, adversatrix, quae fornicata es cum amatoribus multis, auro et argento, lapide et ligno; revertere et suscipiam te.","czech":"Poznamenej, že zde Bůh činí čtyři věci: Za prvé přijal unavené, nasytil hladové, poučuje nevzdělané a uzdravuje nemocné. Tak Pán duchovně jedná dnes a v každé době. Když jsme unaveni hříchy a už nemůžeme více hřešit, takže je nutné ⟦…⟧ a musíme je opustit, Pán nás přesto, unavené hříchy, chce ze svého milosrdenství přijmout. Tak praví v Ezechielovi: Vrať se, odpůrkyně, která jsi smilnila s mnoha milenci, se zlatem a stříbrem, kamenem a dřevem; vrať se a přijmu tě.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f84r_p08","title":"Poučení nevzdělaných","line_ids":["f84r_l087","f84r_l088","f84r_l089","f84r_l090","f84r_l091","f84r_l092","f84r_l093","f84r_l094","f84r_l095"],"latin":"Secundo indoctos instruit, et hoc facit per suam sanctam internam admonitionem vel per praedicatores suos, qui homines instruunt in verbo Dei, ut cognoscant eorum vitam, quantum proficiunt in peccatis et quantum deficiunt in Dei gratia. Et sicut lux illuminat tenebras, sic verbum Dei illuminat tenebrosa peccatorum corda. Tertio infirmos","czech":"Za druhé poučuje nevzdělané; to činí svým svatým vnitřním napomínáním nebo prostřednictvím svých kazatelů, kteří lidi poučují v Božím slově, aby poznali svůj život, nakolik postupují v hříších a nakolik upadají v Boží milosti. A jako světlo osvětluje tmu, tak Boží slovo osvětluje temná srdce hříšníků. Za třetí nemocné","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/84r.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/84r/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0084R.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/84r/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/84r/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/84r/reconstruction.tei.xml"},{"name":"Latinská rekonstrukce TXT","href":"data/84r/reconstruction.la.txt"},{"name":"Český překlad TXT","href":"data/84r/translation.cs.txt"}],"document_id":"vkol-m-ii-220","document_uri":"https://rukopisy.digitalizaty.cz/rukopisy/vkol-m-ii-220","repository":{"name":"Vědecká knihovna v Olomouci","uri":"https://www.vkol.cz/","settlement":"Olomouc","country":"Česko"}}
