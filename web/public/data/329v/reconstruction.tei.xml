      <zone xml:id="f329v_l040_zone" type="htr-segment" points="559,5008 559,5072 671,5085 674,5085 676,5085 775,5053 910,5053 1107,5080 1109,5080 1112,5080 1229,5048 1428,5074 1431,5074 1434,5074 1543,5042 1723,5058 1726,5058 1729,5058 1777,5040 1973,5037 2125,5066 2127,5066 2327,5032 2513,5061 2515,5061 2576,5058 2579,5058 2643,5029 2824,5056 2826,5056 3177,5050 3180,5050 3228,5027 3342,5027 3437,5048 3440,5048 3443,5048 3528,5016 3586,5016 3639,5040 3642,5040 3645,5040 3647,5040 3722,5019 3836,5042 3839,5042 3841,5042 3897,5016 3897,4958 3892,4867 3786,4870 3783,4870 3730,4891 3549,4873 3546,4873 3544,4873 3485,4902 3315,4886 3313,4886 3310,4886 3262,4910 3103,4912 2579,4915 2452,4888 2449,4888 2446,4888 2372,4918 2212,4896 2210,4896 2207,4896 2114,4923 1944,4907 1941,4907 1939,4907 1907,4918 1848,4896 1846,4896 1843,4896 1686,4899 1535,4934 1288,4934 1205,4904 1202,4904 1200,4904 1197,4904 1080,4934 979,4907 977,4907 974,4907 756,4910 753,4910 706,4928 557,4918 559,5008" ulx="557" uly="4867" lrx="3897" lry="5085"/>
