["f82v_l089"],"bbox":[2464,5078,1431,160],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/82v/f82v_l089.webp","raw_htr":{"catmus":"Xbiit aͥrs rcͣ Iudeis sibi insi","medusa":"delijit iheus etc. iudeis sibi in si"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f82v_l090","source_segment_ids":["f82v_l090"],"bbox":[2511,5194,1372,108],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/82v/f82v_l090.webp","raw_htr":{"catmus":"diangibꝰ et eu tradẽ uolertiba","medusa":"diantibus et eum tradere volentibus"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f82v_l091","source_segment_ids":["f82v_l091"],"bbox":[2493,5264,1315,160],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/82v/f82v_l091.webp","raw_htr":{"catmus":"Ab illis abiit quia tꝑus sue","medusa":"Ab illis abiit qua tempus sue"},"words":[],"flags":[],"note":null,"hit_token_limit":false}],"passages":[{"id":"f82v_p01","title":"Prosba o Boží pomoc","line_ids":["f82v_l001","f82v_l002","f82v_l003","f82v_l004","f82v_l005","f82v_l006","f82v_l007","f82v_l008","f82v_l009","f82v_l010"],"latin":"repellas in finem. Quare faciem tuam avertis, oblivisceris tribulationis nostrae? Adhaesit in terra venter noster; exsurge, Domine, adiuva nos et libera nos. In tertia dominica ⟦… mater Christiana?⟧ exhortatur Dominum pro auxilio, dicens: Adiutor in tribulationibus, respice in opportunitatibus in tribulatione. Sperent in te qui noverunt te, quoniam non derelinquis diligentes te, Domine.","czech":"nezavrhuj navždy. Proč odvracíš svou tvář a zapomínáš na naše soužení? Naše břicho přilnulo k zemi; povstaň, Pane, pomoz nám a vysvoboď nás. Třetí neděli ⟦… křesťanská matka?⟧ vybízí Pána, aby pomohl, slovy: Pomocníku v souženích, pohlédni v příhodný čas v soužení. Ať v tebe doufají ti, kdo tě znají, neboť neopouštíš ty, kdo tě milují, Pane.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p02","title":"Útěcha a vzpomínka na milosrdenství","line_ids":["f82v_l011","f82v_l012","f82v_l013","f82v_l014","f82v_l015","f82v_l016","f82v_l017","f82v_l018","f82v_l019","f82v_l020","f82v_l021","f82v_l022","f82v_l023","f82v_l024"],"latin":"In quarta dominica dat eis Dominus consolationem, quia post multos dies liberaturus est eos, cum dicit: Invocavit me et ego exaudiam eum, eripiam eum et glorificabo eum; longitudine dierum adimplebo eum. In quinta dominica rogatus est Dominus in eorum persona, ut non oblivisceretur liberationem eorum, ibi: Reminiscere miserationum tuarum, Domine, et misericordiae tuae, quae a saeculo sunt. Ne unquam dominentur nobis inimici nostri; libera nos, Deus Israel, ex omnibus angustiis nostris.","czech":"Čtvrtou neděli jim Pán dává útěchu, protože je po mnoha dnech vysvobodí, když říká: Vzýval mě a já ho vyslyším, vytrhnu ho a oslavím; naplním ho délkou dnů. Pátou neděli je Pán jejich jménem žádán, aby nezapomněl na jejich vysvobození, tam, kde se praví: Rozpomeň se, Pane, na své slitování a milosrdenství, které trvají od věků. Kéž nad námi nikdy nevládnou naši nepřátelé; vysvoboď nás, Bože Izraele, ze všech našich úzkostí.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p03","title":"Neděle Oculi a úplné vysvobození","line_ids":["f82v_l025","f82v_l026","f82v_l027","f82v_l028","f82v_l029","f82v_l030","f82v_l031","f82v_l032","f82v_l033","f82v_l034","f82v_l035","f82v_l036"],"latin":"In sexta dominica memoratur illud, quando rex dedit eis licentiam, sed non per totum; ⟦…⟧ de: Oculi mei semper ad Dominum, quoniam ipse evellet de laqueo pedes meos; respice in me et miserere mei, quoniam unicus et pauper sum ego. In praesenti vero dominica fecit eos per totum liberos et dedit eis licentiam sine contradictione, et exierunt cum laetitia a captivitate. Ideo hodie totum officium est iocundum et laetum.","czech":"Šestou neděli se připomíná, jak jim král dal svolení, ale ještě ne úplné; ⟦…⟧ ze slov: Mé oči jsou stále obráceny k Pánu, neboť on vytrhne mé nohy z léčky; pohlédni na mne a smiluj se nade mnou, neboť jsem osamělý a chudý. Dnešní neděli je však učinil zcela svobodnými a dal jim svolení bez překážky; s radostí vyšli ze zajetí. Proto je dnes celé oficium veselé a radostné.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p04","title":"Radostné zpěvy","line_ids":["f82v_l037","f82v_l038","f82v_l039","f82v_l040","f82v_l041","f82v_l042","f82v_l043","f82v_l044","f82v_l045","f82v_l046"],"latin":"Introitus enim canitur sic: Laetare Ierusalem et conventum facite omnes qui diligitis eam; gaudete cum laetitia qui in tristitia fuistis, ut exsultetis et satiemini ab uberibus consolationis vestrae. Versus: Laetatus sum in his quae dicta sunt mihi: In domum Domini ibimus. Et Kyrie paschale, et graduale: Laetatus ⟦…⟧. Et totum officium tractat de gaudio.","czech":"Introit se totiž zpívá takto: Raduj se, Jeruzaléme, a shromážděte se všichni, kdo jej milujete; radujte se s veselím, vy, kteří jste byli zarmouceni, abyste jásali a nasytili se z prsů své útěchy. Verš: Zaradoval jsem se z toho, co mi bylo řečeno: Půjdeme do domu Páně. A velikonoční Kyrie a graduál: Zaradoval jsem se ⟦…⟧. Celé oficium pojednává o radosti.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p05","title":"Duchovní babylonské zajetí","line_ids":["f82v_l047","f82v_l048","f82v_l049","f82v_l050","f82v_l051","f82v_l052","f82v_l053","f82v_l054","f82v_l055","f82v_l056","f82v_l057","f82v_l058"],"latin":"Spiritualiter per Septuagesimam intelligitur tempus post hanc vitam. Iam enim sumus in hoc mundo in captivitate Babylonis, id est confusionis, quia hic est omnis confusio et pudor. Et tenet nos ⟦forte?⟧ in potestate diabolus, qui nos possidet. Ex hac captivitate non possumus venire ⟦…⟧ lxx, quando rex Dominus et Deus ducet nos in terram promissionis, id est in vitam aeternam.","czech":"V duchovním smyslu se Septuagesimou rozumí doba po tomto životě. Nyní jsme totiž v tomto světě v babylonském zajetí, to jest ve zmatku, protože zde je veškerý zmatek a hanba. A ďábel, který nás vlastní, nás drží ⟦pevně?⟧ ve své moci. Z tohoto zajetí nemůžeme vyjít ⟦…⟧ sedmdesát, až nás král, Pán a Bůh přivede do zaslíbené země, totiž do věčného života.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p06","title":"Cesta do nebeské vlasti","line_ids":["f82v_l059","f82v_l060","f82v_l061","f82v_l062","f82v_l063","f82v_l064","f82v_l065"],"latin":"Et sicut filii Israel venerunt cum magna tribulatione in terram promissionis, sic nos, si voluerimus venire ad patriam caelestem, sic oportet nos venire cum tribulatione et dolore, non cum gaudio. Etiam dicitur iste dominicus","czech":"A jako synové Izraele přišli do zaslíbené země s velkým soužením, tak i my, chceme-li přijít do nebeské vlasti, musíme přijít se soužením a bolestí, nikoli s radostí. Tato neděle se také nazývá","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p07","title":"Papežská růže a Kristova přirozenost","line_ids":["f82v_l066","f82v_l067","f82v_l068","f82v_l069","f82v_l070","f82v_l071","f82v_l072","f82v_l073","f82v_l074","f82v_l075","f82v_l076","f82v_l077","f82v_l078","f82v_l079","f82v_l080","f82v_l081"],"latin":"dies roseus, quia sicut hodie ⟦…⟧ papa portat rosam, quae ex tribus est composita, scilicet ex auro et balsamo et chrismate. Per rosam Christus intelligitur; per aurum divinitas, per ⟦…⟧ balsami ⟦interior?⟧ Christi humanitas. Per chrisma signatur, quia ⟦erat?⟧ medium inter deitatem et humanitatem. Et sicut haec rosa non semper portatur a papa, sic praedicta divinitas et humanitas non hic a nobis videtur, quia nemo in hac vita unquam vidit Deum; sed post hanc vitam ibi tunc omnes electi videbunt eum facie ad faciem, et cetera.","czech":"dnem růže, protože jako dnes ⟦…⟧ papež nosí růži, která je složena ze tří věcí, totiž ze zlata, balzámu a křižma. Růží se rozumí Kristus, zlatem božství, ⟦…⟧ balzámu ⟦vnitřní?⟧ Kristovo lidství. Křižmem se označuje, že ⟦bylo?⟧ prostředníkem mezi božstvím a lidstvím. A jako papež nenosí tuto růži vždy, tak zde nevidíme řečené božství a lidství, protože nikdo v tomto životě nikdy neviděl Boha; po tomto životě tam však všichni vyvolení uvidí jeho tvář, a tak dále.","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p08","title":"Dokončení půstu","line_ids":["f82v_l082","f82v_l083","f82v_l084","f82v_l085","f82v_l086","f82v_l087","f82v_l088"],"latin":"Ad ⟦devotandos?⟧ omnes propter Deum hucusque ieiunaverunt et ad medium pervenerunt; ulterius debent proficere ad bonum, scilicet in caritate ieiunando. Illis faciet Dominus laetum convivium in aeterno gaudio. Pro impetratione, et cetera. ⟦Summa est?⟧","czech":"K ⟦povzbuzení zbožnosti?⟧ se všichni pro Boha až dosud postili a dospěli do poloviny; dále mají postupovat v dobru, totiž postit se v lásce. Těm Pán připraví radostnou hostinu ve věčné radosti. K jejímu vyprošení, a tak dále. ⟦Shrnutí je?⟧","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]},{"id":"f82v_p09","title":"Ježíšův odchod před úklady","line_ids":["f82v_l089","f82v_l090","f82v_l091"],"latin":"Abiit Iesus, et cetera. Iudaeis sibi insidiantibus et eum tradere volentibus, ab illis abiit, quia tempus suae","czech":"Ježíš odešel, a tak dále. Když mu Židé strojili úklady a chtěli jej vydat, odešel od nich, protože čas jeho","notes":"Pracovní rozvedení zkratek a četba podle obrazu a obou HTR; nejistoty jsou výslovně označeny.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/82v.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/82v/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0082V.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/82v/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/82v/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/82v/reconstruction.tei.xml"},{"name":"Latinská rekonstrukce TXT","href":"data/82v/reconstruction.la.txt"},{"name":"Český překlad TXT","href":"data/82v/translation.cs.txt"}],"document_id":"vkol-m-ii-220","document_uri":"https://rukopisy.digitalizaty.cz/rukopisy/vkol-m-ii-220","repository":{"name":"Vědecká knihovna v Olomouci","uri":"https://www.vkol.cz/","settlement":"Olomouc","country":"Česko"}}
