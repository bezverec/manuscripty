/crops/216r/f216r_l102.webp","raw_htr":{"catmus":"posea ioddit uacoistiꝯ tẜłicꝭ t̾nacõis","medusa":"postea redditur racione istius t̃p̃licꝭ t̃minacionis"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l103","source_segment_ids":["f216r_l103"],"bbox":[2332,4576,1500,160],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l103.webp","raw_htr":{"catmus":"Soeta deplaceat tibi sancta trimitus","medusa":"Sexta deplaceat tibi sancta trinitas"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l104","source_segment_ids":["f216r_l104"],"bbox":[2329,4681,838,118],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l104.webp","raw_htr":{"catmus":"ubi puis qronitut","medusa":"vbi primo exponitur"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l105","source_segment_ids":["f216r_l105"],"bbox":[2356,4757,968,138],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l105.webp","raw_htr":{"catmus":"dst. queru:quo di dici","medusa":"post querit / ⁊ quod dicit"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l106","source_segment_ids":["f216r_l106"],"bbox":[2326,4856,1256,127],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l106.webp","raw_htr":{"catmus":"post in sine quid d fleri poste","medusa":"post in fine quid d fiere postea"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l107","source_segment_ids":["f216r_l107"],"bbox":[2334,4944,1611,157],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l107.webp","raw_htr":{"catmus":"wptio agitur de bndte q̃ dat i fine ubi","medusa":"septimo agitur de bene dice̾ q̃ dat sine ubi"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l108","source_segment_ids":["f216r_l108"],"bbox":[2307,5021,538,123],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l108.webp","raw_htr":{"catmus":"acc notant","medusa":"hoc notavit"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f216r_l109","source_segment_ids":["f216r_l109"],"bbox":[2354,5087,909,148],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/216r/f216r_l109.webp","raw_htr":{"catmus":"pmo quonõ dari","medusa":"pͥmo quomõ d. dati"},"words":[],"flags":[],"note":null,"hit_token_limit":false}],"passages":[{"id":"f216r_p01","title":"Chléb a odpuštění","line_ids":["f216r_l001","f216r_l002","f216r_l003","f216r_l004","f216r_l005","f216r_l006","f216r_l007","f216r_l008","f216r_l009","f216r_l010","f216r_l011","f216r_l012","f216r_l013","f216r_l014","f216r_l015","f216r_l016","f216r_l017"],"latin":"Sequitur Panem nostrum, ubi primo quaeritur quot sunt panes. Secundo quare non dicitur supersubstantialem sicut dicit Matthaeus. Tertio quare dicit cotidianum. Quarto quare dicit hodie. Quinto quomodo intelligitur et nota ibi plurima et moralia. Sequitur Dimitte nobis, ubi notantur multa de expositione istius verbi debita. Postea quaeritur utrum debeamus offensas dimittere. Item utrum homo qui sit in statu perfectionis possit petere iustitiam. Item si peccatores debeant dicere hanc orationem. Item utrum bene dicatur Dimitte nobis sicut et nos dimittimus. Postea quaedam moralia.","czech":"Následuje Chléb náš: kolik je chlebů, proč se neříká supersubstantialem jako u Matouše, proč se říká každodenní a dnes, jak se slovům rozumí; mnoho poznámek a mravních poučení. U Odpusť nám je výklad slova dluhy. Zda máme odpouštět urážky, zda člověk ve stavu dokonalosti může žádat spravedlnost, zda mají tuto modlitbu říkat hříšníci a zda se náležitě říká Odpusť nám, jako i my odpouštíme. Poté mravní poučení.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p02","title":"Pokušení a osvobození od zla","line_ids":["f216r_l018","f216r_l019","f216r_l020","f216r_l021","f216r_l022","f216r_l023","f216r_l024","f216r_l025","f216r_l026","f216r_l027","f216r_l028"],"latin":"Sequitur Et ne nos inducas, ubi quaeritur utrum Deus temptet aliquem. Item utrum aliquis possit petere licite ut temptetur. Postea moralia. Sequitur Sed libera nos a malo, ubi primo littera exponitur. Secundo quare hoc a populo respondetur quaeritur. Tertio quare Amen non respondetur notatur. Quarto quare tacite Amen dicitur declaratur. Post moralia.","czech":"Následuje A neuveď nás: zda Bůh někoho pokouší a zda lze dovoleně prosit o pokušení. Poté mravní poučení. U Ale zbav nás od zlého je výklad textu, proč tato slova odpovídá lid, proč neodpovídá Amen a proč se Amen říká tiše; poté mravní poučení.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p03","title":"Pořadí proseb","line_ids":["f216r_l029","f216r_l030","f216r_l031","f216r_l032","f216r_l033","f216r_l034","f216r_l035","f216r_l036","f216r_l037"],"latin":"Postea moventur quaedam dubia circa totam orationem. Primo utrum istae petitiones bene ordinentur. Secundo quare in primis petitionibus loquitur ⟦temporaliter?⟧. Tertio quare in primis petitionibus non ponitur copula. Quarto quare in quibusdam locis manus sacerdotis sustentantur dum dicit hanc orationem. In fine laudes istius orationis ponuntur.","czech":"Poté otázky k celé modlitbě: zda jsou prosby dobře uspořádány, proč se v prvních prosbách mluví ⟦časově?⟧, proč se v nich nevkládá spojka a proč se někde podpírají knězovy ruce, když ji říká. Na konci se uvádějí chvály této modlitby.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p04","title":"Libera a patena","line_ids":["f216r_l038","f216r_l039","f216r_l040","f216r_l041","f216r_l042","f216r_l043","f216r_l044","f216r_l045","f216r_l046","f216r_l047","f216r_l048"],"latin":"Sequitur Libera quaesumus ⟦…⟧, ubi primo littera exponitur. Postea quaeritur quare illi sancti nominantur in speciali. Item quare haec oratio sub silentio dicitur. Item quare sacerdos tunc patenam accipit. Item diaconus patenam tenet coopertam. Item de ecclesia Ambrosiana quae alte haec verba dicit in ⟦…⟧. Item quare in fine orationis sacerdos debet cooperire calicem.","czech":"Následuje Libera quaesumus ⟦…⟧: výklad textu a proč se jmenují právě tito svatí, proč se modlitba říká tiše a proč kněz tehdy přijímá patenu. Jáhen drží patenu zakrytou. O ambrosiánské církvi, která tato slova říká hlasitě v ⟦…⟧. Proč má kněz na konci modlitby zakrýt kalich.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p05","title":"Lámání hostie a Pax Domini","line_ids":["f216r_l049","f216r_l050","f216r_l051","f216r_l052","f216r_l053","f216r_l054","f216r_l055","f216r_l056","f216r_l057","f216r_l058","f216r_l059","f216r_l060","f216r_l061","f216r_l062","f216r_l063","f216r_l064","f216r_l065"],"latin":"Sequitur Pax Domini, ubi littera exponitur et ritus assignatur. Postea sequuntur multae quaestiones. Primo quid significat fractio hostiae. Secundo quid significant partes. Tertio unaquaeque quid significat. ⟦…⟧ Quinto quid significat commixtio. Quarto de diverso ritu agitur. Sexto quomodo est in qualibet parte. Postea de Pax Domini quaeritur quare a sacerdote inchoatur. Secundo quare dicitur pax. Tertio quare fiunt tres cruces. Quarto quare officium Romanum interponit aliquod silentium.","czech":"U Pax Domini se vykládá text a určuje obřad. Co znamená lámání hostie a její části, co znamená každá jednotlivá část. ⟦…⟧ Co znamená smísení; dále o různém obřadu a jak je přítomen v každé části. Proč Pax Domini začíná kněz, proč se říká pokoj, proč se činí tři kříže a proč římský obřad vkládá chvíli ticha.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p06","title":"Agnus Dei a přijímání","line_ids":["f216r_l066","f216r_l067","f216r_l068","f216r_l069","f216r_l070","f216r_l071","f216r_l072","f216r_l073","f216r_l074","f216r_l075","f216r_l076","f216r_l077"],"latin":"Post de Agnus Dei. Primo quare Christus Agnus Dei dicitur. Secundo quare ter cantatur. Tertio quare in primis duobus dicitur miserere nobis. Quarto quare pax datur. Quinto quomodo debet dari. Sexto quare non datur in missis defunctorum. Septimo quid sacerdos debet dicere. Sequitur Domine Iesu Christe, ubi littera exponitur et multa de modo sumendi notantur.","czech":"Poté o Agnus Dei: proč se Kristus nazývá Beránek Boží, proč se zpívá třikrát a v prvních dvou případech říká smiluj se nad námi. Proč se dává pozdravení pokoje, jak se má dávat a proč se nedává při mších za zemřelé; co má říkat kněz. U Domine Iesu Christe se vykládá text a uvádí mnoho o způsobu přijímání.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p07","title":"Díkůvzdání a Ite missa est","line_ids":["f216r_l078","f216r_l079","f216r_l080","f216r_l081","f216r_l082","f216r_l083","f216r_l084","f216r_l085","f216r_l086","f216r_l087","f216r_l088","f216r_l089","f216r_l090","f216r_l091","f216r_l092","f216r_l093"],"latin":"Sequitur ultima pars pertinens ad formam quae dicitur gratiarum actio. Et primo de oratione quare sic dicitur et cantatur. Secundo de collecta de qua multa notantur. Primo quando debet dici. Secundo quomodo debet se vertere. Tertio qualiter aliqui vadunt ad medium altaris. Quarto quot collectae debent dici. Quinto quid significant. Tertio de Ite missa est, circa quod notantur haec. Primo quod missa tribus modis finitur. Secundo unde sumptum est Ite missa est. Tertio quid significat. Quarto quando debet dici. Quinto quomodo debet dici.","czech":"Následuje poslední část zvaná díkůvzdání: proč se modlitba tak říká a zpívá. O kolektě: kdy se má říkat, jak se má kněz obrátit, jak někteří jdou doprostřed oltáře, kolik má být kolekt a co znamenají. O Ite missa est: mše se končí třemi způsoby; odkud jsou tato slova převzata, co znamenají, kdy a jak se mají říkat.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p08","title":"Další závěrečné formule","line_ids":["f216r_l094","f216r_l095","f216r_l096","f216r_l097","f216r_l098","f216r_l099","f216r_l100","f216r_l101","f216r_l102"],"latin":"Quarto agitur de Benedicamus Domino, ubi tria notantur. Primo unde sumptum est. Secundo quando debet dici. Tertio quomodo debet dici. Quinto de Requiescat in pace, ubi notantur duo. Primo quando debet dici. Secundo quomodo debet dici. Postea redditur ratio istius triplicis terminationis.","czech":"Dále Benedicamus Domino: odkud je převzato, kdy a jak se má říkat. U Requiescat in pace se uvádí, kdy a jak se má říkat. Poté důvod tohoto trojího zakončení.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f216r_p09","title":"Placeat a požehnání","line_ids":["f216r_l103","f216r_l104","f216r_l105","f216r_l106","f216r_l107","f216r_l108","f216r_l109"],"latin":"Sexto de Placeat tibi sancta Trinitas, ubi primo exponitur. Post quaeritur ⟦quomodo debet dici?⟧. Post in fine quid debet fieri postea. Septimo agitur de benedictione quae datur in fine, ubi haec notantur. Primo quomodo debet dari.","czech":"Poté Placeat tibi sancta Trinitas: nejprve výklad a otázka ⟦jak se má říkat?⟧; nakonec co se má provést potom. O závěrečném požehnání: jak se má udělovat.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/216r.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/216r/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0216R.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/216r/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/216r/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/216r/reconstruction.tei.xml"},{"name":"Latinská rekonstrukce TXT","href":"data/216r/reconstruction.la.txt"},{"name":"Český překlad TXT","href":"data/216r/translation.cs.txt"}],"document_id":"vkol-m-ii-220","document_uri":"https://rukopisy.digitalizaty.cz/rukopisy/vkol-m-ii-220","repository":{"name":"Vědecká knihovna v Olomouci","uri":"https://www.vkol.cz/","settlement":"Olomouc","country":"Česko"}}
