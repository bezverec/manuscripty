          <TextLine ID="l17" HPOS="498" VPOS="2871" WIDTH="2707" HEIGHT="190">
            <String ID="s17" CONTENT="Jm sprechnnd Eya gut͛ knecht bud getrew wenn̄ du ùbir" HPOS="498" VPOS="2871" WIDTH="2707" HEIGHT="190"/>
