        "f16r_l042",
        "f16r_l043",
        "f16r_l044"
      ],
      "latin": "Desiderium. Gaudium. Collegium. Complementum. Benignitas. Suavitas. Sanctitas. Caritas. Magna. Maiora. Maxima. Excellentissima.",
      "czech": "Touha. Radost. Společenství. Naplnění. Dobrotivost. Líbeznost. Svatost. Láska. Velké. Větší. Největší. Nejznamenitější.",
      "notes": "Začátek pravého sloupce. Komparativ Maiora je čitelný v souvislém nativním výřezu.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_16r_005",
      "title": "Úsek 5",
      "line_ids": [
        "f16r_l045",
