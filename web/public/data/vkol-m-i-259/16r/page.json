        "f16r_l028",
        "f16r_l029",
        "f16r_l030",
        "f16r_l031",
        "f16r_l032"
      ],
      "latin": "Multa. Magna. Bona. Dulcia. Bona. Meliora. Optima. Inaestimabilia.",
      "czech": "Mnohé. Velké. Dobré. Sladké. Dobré. Lepší. Nejlepší. Neocenitelné.",
      "notes": "Poslední dvě čtveřice levého sloupce, nikoli věta.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_16r_004",
      "title": "Úsek 4",
      "line_ids": [
        "f16r_l033",
        "f16r_l034",
