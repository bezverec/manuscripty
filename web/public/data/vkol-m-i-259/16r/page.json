        "f16r_l011",
        "f16r_l012"
      ],
      "latin": "Meritum. Gaudium. Praemium. Pretium. Societas. Satietas. Sanitas. Perennitas. Accipiens. Habens. Manens. Fruens.",
      "czech": "Zásluha. Radost. Odměna. Cena. Společenství. Nasycení. Zdraví. Věčné trvání. Přijímající. Mající. Zůstávající. Požívající.",
      "notes": "Začátek levého sloupce, pokračování slovníku církve vítězné. Perennitas je návrhově normalizované rozvedení rukopisného perhennitas.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_16r_002",
      "title": "Úsek 2",
      "line_ids": [
        "f16r_l013",
        "f16r_l014",
        "f16r_l015",
        "f16r_l016",
        "f16r_l017",
        "f16r_l018",
        "f16r_l019",
        "f16r_l020",
        "f16r_l021",
        "f16r_l022",
        "f16r_l023",
        "f16r_l024"
      ],
      "latin": "Honestas. Potestas. Maiestas. Voluntas. Agiliter. Subtiliter. Sufficienter. Perenniter. Dulcedo. Plenitudo. Vicissitudo. Longitudo.",
      "czech": "Počestnost. Moc. Velebnost. Vůle. Hbitě. Jemně. Dostatečně. Trvale. Sladkost. Plnost. Střídání. Délka.",
      "notes": "Dodatečné skutečné otevření pásu17–24 opravilo předběžné zaměnění příslovečných zkratek za podstatná jména a čtení crassitudo na vicissitudo. Výsledný přepis není mechanický přepis modelu, opírá se o kontrolu obrazu.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_16r_003",
      "title": "Úsek 3",
      "line_ids": [
        "f16r_l025",
        "f16r_l026",
