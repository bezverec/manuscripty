  <Layout>
    <Page ID="p_151r" PHYSICAL_IMG_NR="1" WIDTH="3900" HEIGHT="5600">
      <PrintSpace HPOS="0" VPOS="0" WIDTH="3900" HEIGHT="5600">
        <TextBlock ID="b1" HPOS="420" VPOS="500" WIDTH="2742" HEIGHT="184">
          <TextLine ID="l1" HPOS="420" VPOS="500" WIDTH="2742" HEIGHT="184">
            <String ID="s1" CONTENT="das sy mich enphaen in yr hewusze und lued iglichen geld" HPOS="420" VPOS="500" WIDTH="2742" HEIGHT="184"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b2" HPOS="438" VPOS="622" WIDTH="2714" HEIGHT="202">
          <TextLine ID="l2" HPOS="438" VPOS="622" WIDTH="2714" HEIGHT="202">
            <String ID="s2" CONTENT="seins h͛sz und sp͛ch zu dē ersten wie vil soltu meyne͛" HPOS="438" VPOS="622" WIDTH="2714" HEIGHT="202"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b3" HPOS="423" VPOS="762" WIDTH="2708" HEIGHT="202">
          <TextLine ID="l3" HPOS="423" VPOS="762" WIDTH="2708" HEIGHT="202">
            <String ID="s3" CONTENT="hẏ gebn̄ er sp̄ch hindirt mozzöls / do sp̄ch er zu im" HPOS="423" VPOS="762" WIDTH="2708" HEIGHT="202"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b4" HPOS="395" VPOS="902" WIDTH="2826" HEIGHT="180">
          <TextLine ID="l4" HPOS="395" VPOS="902" WIDTH="2826" HEIGHT="180">
            <String ID="s4" CONTENT="nu schrib drote funnfczig · do sp͛ch er zuͦ dē andh · wie" HPOS="395" VPOS="902" WIDTH="2826" HEIGHT="180"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b5" HPOS="398" VPOS="1036" WIDTH="2848" HEIGHT="189">
          <TextLine ID="l5" HPOS="398" VPOS="1036" WIDTH="2848" HEIGHT="189">
            <String ID="s5" CONTENT="vil soltu / er sp͛ch hindeirt moͤsz weysz / nym dē briiff" HPOS="398" VPOS="1036" WIDTH="2848" HEIGHT="189"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b6" HPOS="385" VPOS="1172" WIDTH="2861" HEIGHT="196">
          <TextLine ID="l6" HPOS="385" VPOS="1172" WIDTH="2861" HEIGHT="196">
            <String ID="s6" CONTENT="und schrib achtzig und lobt d̄ hie dē myer das er" HPOS="385" VPOS="1172" WIDTH="2861" HEIGHT="196"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b7" HPOS="417" VPOS="1309" WIDTH="2816" HEIGHT="196">
          <TextLine ID="l7" HPOS="417" VPOS="1309" WIDTH="2816" HEIGHT="196">
            <String ID="s7" CONTENT="weislich hett getaͮ · wenn dy kind͛ disz w̾lt weisser" HPOS="417" VPOS="1309" WIDTH="2816" HEIGHT="196"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b8" HPOS="420" VPOS="1449" WIDTH="2739" HEIGHT="224">
          <TextLine ID="l8" HPOS="420" VPOS="1449" WIDTH="2739" HEIGHT="224">
            <String ID="s8" CONTENT="sint den̄ dy kint des liches / und ich sag euch / macht" HPOS="420" VPOS="1449" WIDTH="2739" HEIGHT="224"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b9" HPOS="413" VPOS="1599" WIDTH="2733" HEIGHT="214">
          <TextLine ID="l9" HPOS="413" VPOS="1599" WIDTH="2733" HEIGHT="214">
            <String ID="s9" CONTENT="en̄ch frewut vō dē gut d͛ poͤzheit / wen̄ yr kumpt" HPOS="413" VPOS="1599" WIDTH="2733" HEIGHT="214"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b10" HPOS="407" VPOS="1757" WIDTH="2076" HEIGHT="181">
          <TextLine ID="l10" HPOS="407" VPOS="1757" WIDTH="2076" HEIGHT="181">
            <String ID="s10" CONTENT="das sy euch enphoēn in dy ewige hew͛sz" HPOS="407" VPOS="1757" WIDTH="2076" HEIGHT="181"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b11" HPOS="417" VPOS="1910" WIDTH="2125" HEIGHT="177">
          <TextLine ID="l11" HPOS="417" VPOS="1910" WIDTH="2125" HEIGHT="177">
            <String ID="s11" CONTENT="dominica prima Ca apperuerunt Ihesus in Ierusalem Luc. xix." HPOS="417" VPOS="1910" WIDTH="2125" HEIGHT="177"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b12" HPOS="485" VPOS="2044" WIDTH="2667" HEIGHT="171">
          <TextLine ID="l12" HPOS="485" VPOS="2044" WIDTH="2667" HEIGHT="171">
            <String ID="s12" CONTENT="Do ihuͤs nahet zu Ieruͤm vnd do er die stat sach · do" HPOS="485" VPOS="2044" WIDTH="2667" HEIGHT="171"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b13" HPOS="516" VPOS="2177" WIDTH="2745" HEIGHT="171">
          <TextLine ID="l13" HPOS="516" VPOS="2177" WIDTH="2745" HEIGHT="171">
            <String ID="s13" CONTENT="weynt er vnd sp̃ch / hestu derkant / was dir zufrid" HPOS="516" VPOS="2177" WIDTH="2745" HEIGHT="171"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b14" HPOS="429" VPOS="2311" WIDTH="2820" HEIGHT="174">
          <TextLine ID="l14" HPOS="429" VPOS="2311" WIDTH="2820" HEIGHT="174">
            <String ID="s14" CONTENT="und zuguoden solt komē / nu sint sy vorporegēn vor dem" HPOS="429" VPOS="2311" WIDTH="2820" HEIGHT="174"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b15" HPOS="426" VPOS="2451" WIDTH="3004" HEIGHT="171">
          <TextLine ID="l15" HPOS="426" VPOS="2451" WIDTH="3004" HEIGHT="171">
            <String ID="s15" CONTENT="augē / es w͛dent dy tage komē / das dich deyn fúnde umb" HPOS="426" VPOS="2451" WIDTH="3004" HEIGHT="171"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b16" HPOS="423" VPOS="2579" WIDTH="2879" HEIGHT="180">
          <TextLine ID="l16" HPOS="423" VPOS="2579" WIDTH="2879" HEIGHT="180">
            <String ID="s16" CONTENT="gebün mit eyn grabn̄ und besitczent und beangstigēt dich" HPOS="423" VPOS="2579" WIDTH="2879" HEIGHT="180"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b17" HPOS="420" VPOS="2716" WIDTH="2854" HEIGHT="180">
          <TextLine ID="l17" HPOS="420" VPOS="2716" WIDTH="2854" HEIGHT="180">
            <String ID="s17" CONTENT="allenthalben und zustoͤrēt dich und dein kint. dy in dir" HPOS="420" VPOS="2716" WIDTH="2854" HEIGHT="180"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b18" HPOS="432" VPOS="2849" WIDTH="2938" HEIGHT="190">
          <TextLine ID="l18" HPOS="432" VPOS="2849" WIDTH="2938" HEIGHT="190">
            <String ID="s18" CONTENT="seyn · vnd lossent in dir ein stam nicht uff dē andn̄ · dorū" HPOS="432" VPOS="2849" WIDTH="2938" HEIGHT="190"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b19" HPOS="429" VPOS="3002" WIDTH="2923" HEIGHT="177">
          <TextLine ID="l19" HPOS="429" VPOS="3002" WIDTH="2923" HEIGHT="177">
            <String ID="s19" CONTENT="das du nicht erkant hast dy czeit deines hails / vnd gie" HPOS="429" VPOS="3002" WIDTH="2923" HEIGHT="177"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b20" HPOS="417" VPOS="3132" WIDTH="2963" HEIGHT="200">
          <TextLine ID="l20" HPOS="417" VPOS="3132" WIDTH="2963" HEIGHT="200">
            <String ID="s20" CONTENT="in dē templ und treib darans dy u͛kauff und dy kauff" HPOS="417" VPOS="3132" WIDTH="2963" HEIGHT="200"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b21" HPOS="420" VPOS="3300" WIDTH="2876" HEIGHT="184">
          <TextLine ID="l21" HPOS="420" VPOS="3300" WIDTH="2876" HEIGHT="184">
            <String ID="s21" CONTENT="und sp̃ch es ist geschriben · das mein haws ist ein pet" HPOS="420" VPOS="3300" WIDTH="2876" HEIGHT="184"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b22" HPOS="413" VPOS="3434" WIDTH="2892" HEIGHT="224">
          <TextLine ID="l22" HPOS="413" VPOS="3434" WIDTH="2892" HEIGHT="224">
            <String ID="s22" CONTENT="haws / yr habt ab͛ is gemacht zu eyd͛ hol d͛ dyeꝑ und" HPOS="413" VPOS="3434" WIDTH="2892" HEIGHT="224"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b23" HPOS="438" VPOS="3599" WIDTH="1855" HEIGHT="190">
          <TextLine ID="l23" HPOS="438" VPOS="3599" WIDTH="1855" HEIGHT="190">
            <String ID="s23" CONTENT="was leuͤnde teglich in dē tempel" HPOS="438" VPOS="3599" WIDTH="1855" HEIGHT="190"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b24" HPOS="429" VPOS="3742" WIDTH="2123" HEIGHT="206">
          <TextLine ID="l24" HPOS="429" VPOS="3742" WIDTH="2123" HEIGHT="206">
            <String ID="s24" CONTENT="dominica xiᵃ dixit Ihesus ad qͦsdam Luc. xviiiᵒ." HPOS="429" VPOS="3742" WIDTH="2123" HEIGHT="206"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b25" HPOS="613" VPOS="3885" WIDTH="2611" HEIGHT="243">
          <TextLine ID="l25" HPOS="613" VPOS="3885" WIDTH="2611" HEIGHT="243">
            <String ID="s25" CONTENT="hus sp̃ch zu sein jungn̄ und zu suu̶lichin / dy in selbn̄" HPOS="613" VPOS="3885" WIDTH="2611" HEIGHT="243"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b26" HPOS="610" VPOS="4053" WIDTH="2798" HEIGHT="218">
          <TextLine ID="l26" HPOS="610" VPOS="4053" WIDTH="2798" HEIGHT="218">
            <String ID="s26" CONTENT="nicht trawbē als die rechtū daz peippil / Cʒweniē" HPOS="610" VPOS="4053" WIDTH="2798" HEIGHT="218"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b27" HPOS="432" VPOS="4184" WIDTH="2892" HEIGHT="215">
          <TextLine ID="l27" HPOS="432" VPOS="4184" WIDTH="2892" HEIGHT="215">
            <String ID="s27" CONTENT="schen giengē auff peten in tempel · Eyn phariseus und" HPOS="432" VPOS="4184" WIDTH="2892" HEIGHT="215"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b28" HPOS="423" VPOS="4327" WIDTH="2779" HEIGHT="212">
          <TextLine ID="l28" HPOS="423" VPOS="4327" WIDTH="2779" HEIGHT="212">
            <String ID="s28" CONTENT="ein offenbar sünd / d̄ pharisēus stand und pett mit jm" HPOS="423" VPOS="4327" WIDTH="2779" HEIGHT="212"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b29" HPOS="435" VPOS="4461" WIDTH="2895" HEIGHT="218">
          <TextLine ID="l29" HPOS="435" VPOS="4461" WIDTH="2895" HEIGHT="218">
            <String ID="s29" CONTENT="selbs h̶r̶ got ich sag dir danck / wein̄ ich pin nicht als" HPOS="435" VPOS="4461" WIDTH="2895" HEIGHT="218"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b30" HPOS="429" VPOS="4616" WIDTH="2976" HEIGHT="252">
          <TextLine ID="l30" HPOS="429" VPOS="4616" WIDTH="2976" HEIGHT="252">
            <String ID="s30" CONTENT="and͛ lewch Rawb̄ ungerecht hurer / als ouch der publicꝰ" HPOS="429" VPOS="4616" WIDTH="2976" HEIGHT="252"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
