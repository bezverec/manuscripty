  "passages": [
    {
      "id": "u_17r_001",
      "title": "Úsek 1",
      "line_ids": [
        "f17r_l001",
        "f17r_l002",
        "f17r_l003",
        "f17r_l004",
        "f17r_l005",
        "f17r_l006",
        "f17r_l007",
        "f17r_l008",
        "f17r_l009",
        "f17r_l010",
        "f17r_l011"
      ],
      "latin": "Labora. Ama. Persevera. Providus. Compunctus. Devotus. Timorosus. Sinceritas. Fidelitas. Urbanitas. Curialitas.",
      "czech": "Pracuj. Miluj. Vytrvej. Předvídavý. Zkroušený. Oddaný. Bázlivý. Upřímnost. Věrnost. Uhlazenost. Dvornost.",
      "notes": "Začátek levého sloupce má první skupinu jen se třemi hesly, nevkládám čtvrté. Znění timorosus je návrhové. Dodatečně otevřený pás1–8 opravil předběžné Ora na Ama. Timorosus potvrzuje tvar počátečního písmene v obraze, nepřebírám modelové Amiorosus.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_17r_002",
      "title": "Úsek 2",
      "line_ids": [
        "f17r_l012",
        "f17r_l013",
        "f17r_l014",
        "f17r_l015",
        "f17r_l016",
        "f17r_l017",
        "f17r_l018",
        "f17r_l019",
        "f17r_l020",
        "f17r_l021",
        "f17r_l022",
        "f17r_l023"
      ],
      "latin": "Consilium. Auxilium. Remedium. Adiutorium. Venias. Procedas. Curras. Accipias. Veritas. Caritas. Unanimitas. Pietas.",
      "czech": "Rada. Pomoc. Lék či náprava. Přispění. Přijdi. Pokračuj. Běž. Přijmi. Pravda. Láska. Svornost. Zbožnost.",
      "notes": "U slovesných tvarů jsou možné vybízecí i podmíněné významy; heslový kontext zde přeložen jako výzvy.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_17r_003",
      "title": "Úsek 3",
      "line_ids": [
        "f17r_l024",
        "f17r_l025",
        "f17r_l026",
        "f17r_l027",
        "f17r_l028",
        "f17r_l029",
        "f17r_l030",
        "f17r_l031"
      ],
      "latin": "Confessio. Pulchritudo. Rectitudo. Plenitudo. Pauperies. Temperies. Fides. Spes.",
      "czech": "Vyznání. Krása. Přímost. Plnost. Chudoba. Uměřenost. Víra. Naděje.",
      "notes": "Závěr levého sloupce. Pulchritudo je lehce normalizovaný tvar rukopisného pulcritudo. Segment30 slučuje a ořezává Fides i Spes; obě hesla jsou celá v již otevřeném nativním výřezu. Segment31 je drobný fragment.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_17r_004",
      "title": "Úsek 4",
      "line_ids": [
        "f17r_l032",
        "f17r_l033",
        "f17r_l034",
        "f17r_l035",
        "f17r_l036",
        "f17r_l037",
        "f17r_l038",
        "f17r_l039",
        "f17r_l040",
        "f17r_l041",
        "f17r_l042",
        "f17r_l043"
      ],
      "latin": "Dilige. Attende. Accede. Profice. [Obsignatio?] [Expectatio?] Monitio. Oratio. Vigilans. Orans. Constans. Consolans.",
      "czech": "Miluj. Dávej pozor. Přistup. Prospívej. [Zpečetění?] [Očekávání?] Napomenutí. Modlitba. Bdící. Modlící se. Stálý. Utěšující.",
      "notes": "Dodatečně skutečně otevřené pásy33–40 a41–48 upřesňují podstatná jména. Dvě první zůstávají nejistá; předběžné meditatio se po kontrole mění na monitio.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_17r_005",
      "title": "Úsek 5",
      "line_ids": [
        "f17r_l044",
        "f17r_l045",
        "f17r_l046",
        "f17r_l047",
        "f17r_l048",
        "f17r_l049",
        "f17r_l050",
        "f17r_l051",
        "f17r_l052",
        "f17r_l053",
        "f17r_l054"
      ],
      "latin": "Fallax. Verax. Contumax. Rapax. Niger. [Linter?] Ater. Serviens. Proficiens. Diligens. Praeficiens.",
      "czech": "Klamný. Pravdomluvný. Vzpurný. Dravý či loupeživý. Černý. [Člun? — nejisté heslo.] Temný. Sloužící. Prospívající. Milující. Představující či ustanovující.",
      "notes": "Dodatečné detailní pásy41–48 a49–56 zásadně opravily předběžné čtení této skupiny: nejsou zde doložena dříve navržená Magister, Dux a Auctor. Prostřední heslo mezi Niger a Ater zůstává nejisté; není doplněno podle předpokládaného smyslu.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_17r_006",
