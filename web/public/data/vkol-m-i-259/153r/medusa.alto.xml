          <TextLine ID="l23" HPOS="404" VPOS="3605" WIDTH="2870" HEIGHT="181">
            <String ID="s23" CONTENT="w͛st / so ge und siz an dy nyderst stat / so den̄ koͤpt d͛ dich" HPOS="404" VPOS="3605" WIDTH="2870" HEIGHT="181"/>
