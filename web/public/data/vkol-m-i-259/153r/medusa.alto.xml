          <TextLine ID="l22" HPOS="404" VPOS="3468" WIDTH="2898" HEIGHT="181">
            <String ID="s22" CONTENT="den̄ mit schöm müst habē dy nyderst stat / so du gladuͤ" HPOS="404" VPOS="3468" WIDTH="2898" HEIGHT="181"/>
