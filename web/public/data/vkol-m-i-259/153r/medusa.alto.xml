        <TextBlock ID="b17" HPOS="395" VPOS="2737" WIDTH="2804" HEIGHT="181">
          <TextLine ID="l17" HPOS="395" VPOS="2737" WIDTH="2804" HEIGHT="181">
            <String ID="s17" CONTENT="waͮren ein glichnuͤss · wie sy dy obristn̄ stat erweltin" HPOS="395" VPOS="2737" WIDTH="2804" HEIGHT="181"/>
