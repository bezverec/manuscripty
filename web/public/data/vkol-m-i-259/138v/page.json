  "passages": [
    {
      "id": "u_138v_001",
      "title": "Úsek 1",
      "line_ids": [
        "f138v_l001",
        "f138v_l002"
      ],
      "latin": "Und die leute die sy das ersahen wundert des zuhand und sprachen: Wie tan ist er, wann im gehorsam sind die winde […]",
      "czech": "Lidé, kteří to spatřili, se hned podivili a řekli: Jaký je to člověk, že jej poslouchají větry i moře?",
      "notes": "Poslední und das mer je dodatek vpravo, patří k předchozí větě. ",
      "operations": [],
      "language": "de"
    },
    {
      "id": "u_138v_002",
      "title": "Úsek 2",
      "line_ids": [
        "f138v_l003"
      ],
      "latin": "Dominica [quinta?]. Confitebor tibi. Mathei XI.",
      "czech": "[Pátá?] neděle. Budu tě vyznávat. Matouš XI.",
      "notes": "Číslování neděle nejisté, latinský incipit rukopisný, nepřepsán na jiné znění. ",
      "operations": [],
      "language": "de"
    },
    {
      "id": "u_138v_003",
      "title": "Úsek 3",
      "line_ids": [
        "f138v_l004"
      ],
      "latin": "Und das mer.",
      "czech": "A moře.",
      "notes": "Doplněk uzavírá vlastní větu2, ne novou perikopu.",
      "operations": [],
      "language": "de"
    },
    {
      "id": "u_138v_004",
      "title": "Úsek 4",
      "line_ids": [
        "f138v_l005",
        "f138v_l006",
        "f138v_l007",
        "f138v_l008",
        "f138v_l009",
        "f138v_l010",
        "f138v_l011",
        "f138v_l012",
        "f138v_l013",
        "f138v_l014",
        "f138v_l015",
        "f138v_l016"
      ],
      "latin": "Ihesus sach zu seinen iungern und sprach: Ich verich dir, vater hymels und erden, wann du hast die ding verporgen vor den weisen und den chugen und hast sy geoffent den kinden. Vater, wann also gefiel es dir. Es ist mir alles gegeben von meinem vater, und erchennet auch niemen den […] son denn der vater, noch den vater niemat denn der son und dem es der son kunt tut. Komet zu mir alle die do arbeitent und die beswert sind, und ich hilff euch. Nemt mein ioch uff euch und lernet von mir, wann ich pin senft und demutiges herzen, und ir vindet ewren selen. Mein ioch ist suz und mein purde ringe.",
      "czech": "Ježíš pohlédl na své učedníky a řekl: Vyznávám se ti, Otče nebe a země, neboť jsi tyto věci skryl před moudrými a chytrými a zjevil je dětem. Otče, neboť tak se ti zalíbilo. Všechno mi bylo dáno od mého Otce a nikdo nezná […] Syna než Otec ani Otce nikdo než Syn a ten, komu jej Syn oznámí. Pojďte ke mně všichni, kdo pracujete a jste obtíženi, a já vám pomohu. Vezměte na sebe mé jho a učte se ode mne, neboť jsem mírný a pokorného srdce, a naleznete [odpočinutí?] svým duším. Mé jho je sladké a mé břemeno lehké.",
      "notes": "Přeškrtnuté slovo před son vynecháno jako nevyřešená oprava. Dodatek vindet na pravém okraji patrně doplňuje větu o duších, předmět odpočinutí však není bezpečně přečten a v němčině není canonical doplněn. ",
      "operations": [],
      "language": "de"
    },
    {
      "id": "u_138v_005",
      "title": "Úsek 5",
      "line_ids": [
        "f138v_l017"
      ],
      "latin": "Dominica in Septuagesima. Simile est regnum celorum patri familias. Mathei XX.",
      "czech": "Neděle Septuagesima. Nebeské království se podobá hospodáři. Matouš XX.",
      "notes": " ",
      "operations": [],
      "language": "de"
    },
    {
      "id": "u_138v_006",
      "title": "Úsek 6",
      "line_ids": [
        "f138v_l018",
        "f138v_l019",
        "f138v_l020",
        "f138v_l021",
        "f138v_l022",
        "f138v_l023",
        "f138v_l024",
        "f138v_l025",
        "f138v_l026",
        "f138v_l027",
        "f138v_l028",
        "f138v_l029",
        "f138v_l030",
        "f138v_l031"
      ],
      "latin": "Ihesus sprach zu seinen iungern: Das hymelreich ist gleich einem hauswirt, der des morgens aus get mit den werckleuten in sein weingarten. Do er eins worden hatte mit den werckleuten zu einem tag umb ein pfenning, do sant er sy in sein weingarten. Und zu der dritten weil gieng er aber aus und sach an dem marckt ander sten und sprach zu den: Get auch ir in den weingarten, und was recht ist, das gib ich euch. Die giengen auch hin. Do gieng er aber aus umb die sechste stund und neunte zeit und tet alsam. Zu der ainleften weil gieng er aber aus und vande ander sten und sprach zu den: Was stet ir all den tag mussig? Sy sprachen: Uns dinget niemat. Er sprach zu in: Get auch ir in den weingarten. Do es do spat wart, do sprach der herr zu dem schaffer: Ruff den […]",
      "czech": "Ježíš řekl učedníkům: Nebeské království je podobné hospodáři, který ráno vychází s dělníky na svou vinici. Když se s dělníky dohodl na jednom penízi za den, poslal je na vinici. Ve třetí hodině vyšel znovu, viděl jiné stát na tržišti a řekl jim: Jděte také vy na vinici a dám vám, co je spravedlivé. Také oni šli. Znovu vyšel kolem šesté hodiny a v devátou a učinil totéž. V jedenáctou hodinu vyšel znovu, našel jiné stát a řekl jim: Proč tu stojíte celý den nečinně? Řekli: Nikdo nás nenajímá. On jim řekl: Jděte také na vinici. Když nastal večer, řekl pán správci: Zavolej […].",
      "notes": "Německý pfenning přeložen obecně peníz bez převodu do moderní měny. Číslování denních hodin zachováno. Pokračuje139r. ",
      "operations": [],
      "language": "de"
    },
