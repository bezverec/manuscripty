        <ab xml:lang="de">
          <lb facs="#z_f142v_l001" xml:id="medusa_f142v_l001"/>
          <seg type="raw_unreviewed">11</seg>
          <lb facs="#z_f142v_l002" xml:id="medusa_f142v_l002"/>
          <seg type="raw_unreviewed">hätze das er yn u͛kauff vnd brüste wol daz es ym seyͤ vater</seg>
          <lb facs="#z_f142v_l003" xml:id="medusa_f142v_l003"/>
          <seg type="raw_unreviewed">gab als in sein heide das er kom von im und get zu got</seg>
          <lb facs="#z_f142v_l004" xml:id="medusa_f142v_l004"/>
          <seg type="raw_unreviewed">do stuēd er uff vōdē tissch vnd legte sein gwāt vō im</seg>
          <lb facs="#z_f142v_l005" xml:id="medusa_f142v_l005"/>
          <seg type="raw_unreviewed">und nam eyn tucheln und guͤtte sich damit . doruech</seg>
          <lb facs="#z_f142v_l006" xml:id="medusa_f142v_l006"/>
          <seg type="raw_unreviewed">gez er waſſz in eẏ pelk vnd beguͤd d͛ jung͛ fuez twahū</seg>
          <lb facs="#z_f142v_l007" xml:id="medusa_f142v_l007"/>
          <seg type="raw_unreviewed">und trukken mit der twelbn̄ mit d̾ er sich gegurt hett</seg>
          <lb facs="#z_f142v_l008" xml:id="medusa_f142v_l008"/>
          <seg type="raw_unreviewed">und do er kam zw Symonpetro do sp͛ch zuͦ ym Petrus hr̃</seg>
          <lb facs="#z_f142v_l009" xml:id="medusa_f142v_l009"/>
          <seg type="raw_unreviewed">du twechst mir mein fürze / dez antẅrt ym Jhūs und</seg>
          <lb facs="#z_f142v_l010" xml:id="medusa_f142v_l010"/>
          <seg type="raw_unreviewed">sp͛ch zu im. daz ich da tue. daz wais tu nicht nu. du w͛st</seg>
          <lb facs="#z_f142v_l011" xml:id="medusa_f142v_l011"/>
          <seg type="raw_unreviewed">sein ab͛ h̶u̶o̶c̶h̶ wissund / do sp̃ch aber petrus du twechst</seg>
          <lb facs="#z_f142v_l012" xml:id="medusa_f142v_l012"/>
          <seg type="raw_unreviewed">mein fuez nym̄ ewicleich / des antẃt ym Jh̃us und ap</seg>
          <lb facs="#z_f142v_l013" xml:id="medusa_f142v_l013"/>
          <seg type="raw_unreviewed">ich dich nicht wassch / so hastu nicht teyl a̶n̶c̶h̶t̶ mit mir</seg>
          <lb facs="#z_f142v_l014" xml:id="medusa_f142v_l014"/>
          <seg type="raw_unreviewed">Do sp͛ch ab͛ zuͤ im Symonpetrus / hr͛ nicht alain dy fùez</seg>
          <lb facs="#z_f142v_l015" xml:id="medusa_f142v_l015"/>
          <seg type="raw_unreviewed">sind dy hend und daz haupt Do sp͛ch zuͤ im ihūs de ge-</seg>
          <lb facs="#z_f142v_l016" xml:id="medusa_f142v_l016"/>
          <seg type="raw_unreviewed">wasschd ist d̄ darff nicht and͛s. wann̄ daz mā im dye</seg>
          <lb facs="#z_f142v_l017" xml:id="medusa_f142v_l017"/>
