          <lb facs="#z_f142v_l001" xml:id="catmus_f142v_l001"/>
          <seg type="raw_unreviewed">1</seg>
          <lb facs="#z_f142v_l002" xml:id="catmus_f142v_l002"/>
          <seg type="raw_unreviewed">htre dab er un ulaust und ueuste uol da es uii señ uãt̾</seg>
          <lb facs="#z_f142v_l003" xml:id="catmus_f142v_l003"/>
          <seg type="raw_unreviewed">gab als in sem hende das er bom uon ii bnd get qu got</seg>
          <lb facs="#z_f142v_l004" xml:id="catmus_f142v_l004"/>
          <seg type="raw_unreviewed">dostuẽd ex uff uo dẽ tissch uud legie sem qirãt bo qui</seg>
          <lb facs="#z_f142v_l005" xml:id="catmus_f142v_l005"/>
          <seg type="raw_unreviewed">uũ nam eyi tu cheli uud ginte fich domit, dorioh</seg>
          <lb facs="#z_f142v_l006" xml:id="catmus_f142v_l006"/>
          <seg type="raw_unreviewed">go ex wasẜ in eñ pell und begñd d̾ Iuug̃ fue tirahũ</seg>
          <lb facs="#z_f142v_l007" xml:id="catmus_f142v_l007"/>
          <seg type="raw_unreviewed">und trublen ut der tirehsn mit der sich gegurtheit</seg>
          <lb facs="#z_f142v_l008" xml:id="catmus_f142v_l008"/>
          <seg type="raw_unreviewed">uud do er lam zroidomõyetro do spchi qu ym petrus hr̃</seg>
          <lb facs="#z_f142v_l009" xml:id="catmus_f142v_l009"/>
          <seg type="raw_unreviewed">du trrechst mir mem fueze dez autiot ym Ihũs und</seg>
          <lb facs="#z_f142v_l010" xml:id="catmus_f142v_l010"/>
          <seg type="raw_unreviewed">spch zu Im daꝵ ich da aie daz woaistu nich̃t mi du uost</seg>
          <lb facs="#z_f142v_l011" xml:id="catmus_f142v_l011"/>
          <seg type="raw_unreviewed">sem ab huoch wissund do spch abor petrus du trrechst</seg>
          <lb facs="#z_f142v_l012" xml:id="catmus_f142v_l012"/>
          <seg type="raw_unreviewed">auem fuez nỹiũ eroicteich, des aut̾rot yni Ihũs undes</seg>
          <lb facs="#z_f142v_l013" xml:id="catmus_f142v_l013"/>
          <seg type="raw_unreviewed">nch̃ dichi niche uassch̃ so hastu nich̃t teyl ncht uut nt</seg>
          <lb facs="#z_f142v_l014" xml:id="catmus_f142v_l014"/>
          <seg type="raw_unreviewed">do sp̃ch ab̾ iu im dymopetrus ht nicht alai dy fuer</seg>
          <lb facs="#z_f142v_l015" xml:id="catmus_f142v_l015"/>
          <seg type="raw_unreviewed">suned̃ dy hend und dac haupt do sp̃ch zul imIhus de ge-</seg>
          <lb facs="#z_f142v_l016" xml:id="catmus_f142v_l016"/>
          <seg type="raw_unreviewed">uoasschũ ist d darff ncht aud̾s. Wann daq mã ini dye</seg>
          <lb facs="#z_f142v_l017" xml:id="catmus_f142v_l017"/>
          <seg type="raw_unreviewed">sue tirach und ist deñ gar rayni uud yrfeyt ram</seg>
          <lb facs="#z_f142v_l018" xml:id="catmus_f142v_l018"/>
          <seg type="raw_unreviewed">ncht all. Er iouste nol urer d̾ was d̾ yn wolde</seg>
          <lb facs="#z_f142v_l019" xml:id="catmus_f142v_l019"/>
          <seg type="raw_unreviewed">uoiratũ. dorube spͣch̃ ex ir seyt nicht ali ram/ do ecge</seg>
          <lb facs="#z_f142v_l020" xml:id="catmus_f142v_l020"/>
          <seg type="raw_unreviewed">uoussch yr fuez bud er genã ser girãt und das er ge</seg>
          <lb facs="#z_f142v_l021" xml:id="catmus_f142v_l021"/>
          <seg type="raw_unreviewed">sa do spch er Iusrii wisse yr was icħ euch̃ getã hab</seg>
          <lb facs="#z_f142v_l022" xml:id="catmus_f142v_l022"/>
          <seg type="raw_unreviewed">Ir haist nich maist und hr̃ und sprech̃t doian wol</seg>
          <lb facs="#z_f142v_l023" xml:id="catmus_f142v_l023"/>
          <seg type="raw_unreviewed">Wenĩ ich pius, ob ich maist̃ und̃ qre berach eũr fue</seg>
          <lb facs="#z_f142v_l024" xml:id="catmus_f142v_l024"/>
          <seg type="raw_unreviewed">alro soholt ar ouch anemand̾ wasschũ dy fue: It̃ har</seg>
          <lb facs="#z_f142v_l025" xml:id="catmus_f142v_l025"/>
          <seg type="raw_unreviewed">euch gegꝭ ein pild als icħ euch getã hab. alo tut augb̃i</seg>
          <lb facs="#z_f142v_l026" xml:id="catmus_f142v_l026"/>
          <seg type="raw_unreviewed">Passio sr /o. fiã seꝑ Egssus ihus. Io puriᵒ.</seg>
          <lb facs="#z_f142v_l027" xml:id="catmus_f142v_l027"/>
          <seg type="raw_unreviewed">1</seg>
          <lb facs="#z_f142v_l028" xml:id="catmus_f142v_l028"/>
          <seg type="raw_unreviewed">hũs ging aus nit sem Iugũ ubir den pach Cedit</seg>
          <lb facs="#z_f142v_l029" xml:id="catmus_f142v_l029"/>
          <seg type="raw_unreviewed">do was em gartũ doram giung et und sem Iuug</seg>
          <lb facs="#z_f142v_l030" xml:id="catmus_f142v_l030"/>
          <seg type="raw_unreviewed">die stat douste auch iudas ecrol d yn uourelt daz</seg>
          <lb facs="#z_f142v_l031" xml:id="catmus_f142v_l031"/>
