        <TextBlock ID="b9" HPOS="407" VPOS="1648" WIDTH="2795" HEIGHT="181">
          <TextLine ID="l9" HPOS="407" VPOS="1648" WIDTH="2795" HEIGHT="181">
            <String ID="s9" CONTENT="cw͠dig Get zuͦ dē augang d̄ weg. vnd wen yr fundet" HPOS="407" VPOS="1648" WIDTH="2795" HEIGHT="181"/>
