  "passages": [
    {
      "id": "u_15v_001",
      "title": "Úsek 1",
      "line_ids": [
        "f15v_l001",
        "f15v_l002",
        "f15v_l003",
        "f15v_l004",
        "f15v_l005",
        "f15v_l006",
        "f15v_l007",
        "f15v_l008"
      ],
      "latin": "Duces [dux?]. Spes. Praeses. Leges. Amabilis. Dulcis. Mitis. Nobilis. Virtuosus.",
      "czech": "Vůdcové [vůdce?]. Naděje. Představený. Zákony. Hodný lásky. Sladký. Mírný. Ušlechtilý. Ctnostný.",
      "notes": "Začátek levého sloupce. Vlastní souvislý výřez potvrzuje navíc hesla Spes a Leges, která segmentace nezachytila jako úplné samostatné řádky. První heslo vypadá jako duces; nepřepisuji ho bez nejistoty na očekávané dux. Virtuosus už začíná další čtveřici.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15v_002",
      "title": "Úsek 2",
      "line_ids": [
        "f15v_l009",
        "f15v_l010",
        "f15v_l011",
        "f15v_l012",
        "f15v_l013",
        "f15v_l014",
        "f15v_l015",
        "f15v_l016"
      ],
      "latin": "[drobný fragment bez čitelného textu] Miraculosus. [Sanctimonialis?] Gloriosus. Optimus. Perfectissimus. Clarissimus. [Sapientissimus?]",
      "czech": "[Drobný fragment bez čitelného textu.] Zázračný. [Svatý či zbožný?] Slavný. Nejlepší. Nejdokonalejší. Nejjasnější. [Nejmoudřejší?]",
      "notes": "Dvě rozvedení zkratek zůstávají nejistá. Perfectissimus a clarissimus jsou v obraze čitelnější než původní HTR. Segment9 není další doložené heslo.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15v_003",
      "title": "Úsek 3",
      "line_ids": [
        "f15v_l017",
        "f15v_l018",
        "f15v_l019",
        "f15v_l020",
        "f15v_l021",
        "f15v_l022",
        "f15v_l023",
        "f15v_l024"
      ],
      "latin": "Vocator. Elector. Protector. Amator. Creans. Materians. Naturans. Essentians.",
      "czech": "Povolávající. Vybírající. Ochránce. Milující. Tvořící. Dávající látku. Dávající přirozenost. Dávající bytí.",
      "notes": "Zde se střídají činitelská jména a participia. Neobvyklá materians, naturans a essentians jsou přeložena popisně; nelze je mechanicky zaměňovat za běžná podstatná jména.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15v_004",
      "title": "Úsek 4",
      "line_ids": [
        "f15v_l025",
        "f15v_l026",
        "f15v_l027",
        "f15v_l028",
        "f15v_l029",
        "f15v_l030",
        "f15v_l031",
        "f15v_l032"
      ],
      "latin": "Patientissimus. Caritatissimus. Beatissimus. Desiderantissimus. Vindex. Iudex. Merces. Rex.",
      "czech": "Nejtrpělivější. Nejplnější lásky. Nejblaženější. Nejvíce toužící. Mstitel. Soudce. Odměna. Král.",
      "notes": "Závěr levého sloupce. Caritatissimus je návrhově přepsáno podle viditelného neobvyklého superlativu, nikoli nahrazeno klasickým synonymem. Merces je odměna, ne člověk s osobním jménem.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15v_005",
      "title": "Úsek 5",
      "line_ids": [
        "f15v_l033",
        "f15v_l034",
        "f15v_l035",
        "f15v_l036",
        "f15v_l037",
        "f15v_l038",
        "f15v_l039",
        "f15v_l040",
        "f15v_l041"
      ],
      "latin": "Veritas. Caritas. Aequitas. Plenitas. Magnitudo. Fortitudo. Longitudo. Multitudo. Membra ecclesiae triumphantis.",
      "czech": "Pravda. Láska. Rovnost či spravedlnost. Plnost. Velikost. Síla. Délka. Mnohost. Členy vztahující se k církvi vítězné.",
      "notes": "Začátek pravého sloupce dokončuje předchozí skupinu. Poslední řádek je nové záhlaví, nikoli deváté abstraktní heslo. Plenitas je návrhové čtení.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15v_006",
