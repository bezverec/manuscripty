        <TextBlock ID="b1" HPOS="2508" VPOS="143" WIDTH="31" HEIGHT="90">
          <TextLine ID="l1" HPOS="2508" VPOS="143" WIDTH="31" HEIGHT="90">
            <String ID="s1" CONTENT="p" HPOS="2508" VPOS="143" WIDTH="31" HEIGHT="90"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b2" HPOS="504" VPOS="510" WIDTH="2689" HEIGHT="190">
          <TextLine ID="l2" HPOS="504" VPOS="510" WIDTH="2689" HEIGHT="190">
            <String ID="s2" CONTENT="das han ich ouch kunt getā Ir habt mich nicht dwelt ich" HPOS="504" VPOS="510" WIDTH="2689" HEIGHT="190"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b3" HPOS="507" VPOS="662" WIDTH="2708" HEIGHT="168">
          <TextLine ID="l3" HPOS="507" VPOS="662" WIDTH="2708" HEIGHT="168">
            <String ID="s3" CONTENT="han euch dwelt und dorczu gesaczt das ir get und frucht" HPOS="507" VPOS="662" WIDTH="2708" HEIGHT="168"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b4" HPOS="491" VPOS="793" WIDTH="2742" HEIGHT="183">
          <TextLine ID="l4" HPOS="491" VPOS="793" WIDTH="2742" HEIGHT="183">
            <String ID="s4" CONTENT="preugt. vnd ew͛r frucht bleibē. Wes ir mein waͮr pitt ī" HPOS="491" VPOS="793" WIDTH="2742" HEIGHT="183"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b5" HPOS="488" VPOS="924" WIDTH="1597" HEIGHT="161">
          <TextLine ID="l5" HPOS="488" VPOS="924" WIDTH="1597" HEIGHT="161">
            <String ID="s5" CONTENT="meini nam das er euch das geb ·" HPOS="488" VPOS="924" WIDTH="1597" HEIGHT="161"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b6" HPOS="504" VPOS="1054" WIDTH="1992" HEIGHT="178">
          <TextLine ID="l6" HPOS="504" VPOS="1054" WIDTH="1992" HEIGHT="178">
            <String ID="s6" CONTENT="Ecce ego mitto vos sicut oues in medio luporum" HPOS="504" VPOS="1054" WIDTH="1992" HEIGHT="178"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b7" HPOS="634" VPOS="1191" WIDTH="2743" HEIGHT="177">
          <TextLine ID="l7" HPOS="634" VPOS="1191" WIDTH="2743" HEIGHT="177">
            <String ID="s7" CONTENT="huͤs sp͛ch zuͤ sein jung͛n ich sende euch als dy schöffen" HPOS="634" VPOS="1191" WIDTH="2743" HEIGHT="177"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b8" HPOS="541" VPOS="1325" WIDTH="2764" HEIGHT="174">
          <TextLine ID="l8" HPOS="541" VPOS="1325" WIDTH="2764" HEIGHT="174">
            <String ID="s8" CONTENT="mitten und dy wolff / dorumb seit waiz / als dy slaugē" HPOS="541" VPOS="1325" WIDTH="2764" HEIGHT="174"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b9" HPOS="482" VPOS="1452" WIDTH="2888" HEIGHT="178">
          <TextLine ID="l9" HPOS="482" VPOS="1452" WIDTH="2888" HEIGHT="178">
            <String ID="s9" CONTENT="und einfeltig als dy tawb̄n und hüt euch vor dē lewtē" HPOS="482" VPOS="1452" WIDTH="2888" HEIGHT="178"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b10" HPOS="504" VPOS="1596" WIDTH="2698" HEIGHT="186">
          <TextLine ID="l10" HPOS="504" VPOS="1596" WIDTH="2698" HEIGHT="186">
            <String ID="s10" CONTENT="Sy aͤrtēt ouch zu d̄ sproch und geisselt euch und yr-" HPOS="504" VPOS="1596" WIDTH="2698" HEIGHT="186"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b11" HPOS="485" VPOS="1739" WIDTH="2730" HEIGHT="168">
          <TextLine ID="l11" HPOS="485" VPOS="1739" WIDTH="2730" HEIGHT="168">
            <String ID="s11" CONTENT="menig und zu dē künigen und zu dē grofen wert yr" HPOS="485" VPOS="1739" WIDTH="2730" HEIGHT="168"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b12" HPOS="507" VPOS="1869" WIDTH="2714" HEIGHT="193">
          <TextLine ID="l12" HPOS="507" VPOS="1869" WIDTH="2714" HEIGHT="193">
            <String ID="s12" CONTENT="gefuͤrt durch mich zu ein urkünd yn bid den heyden" HPOS="507" VPOS="1869" WIDTH="2714" HEIGHT="193"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b13" HPOS="510" VPOS="2025" WIDTH="2764" HEIGHT="162">
          <TextLine ID="l13" HPOS="510" VPOS="2025" WIDTH="2764" HEIGHT="162">
            <String ID="s13" CONTENT="so sy euch uonrabē so gedenkt nicht was ad͛ wie yr" HPOS="510" VPOS="2025" WIDTH="2764" HEIGHT="162"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b14" HPOS="491" VPOS="2165" WIDTH="2795" HEIGHT="187">
          <TextLine ID="l14" HPOS="491" VPOS="2165" WIDTH="2795" HEIGHT="187">
            <String ID="s14" CONTENT="redt / yr seit nicht dy do reden · sund͛ d͛ geist ew̄rs vaͤt͛" HPOS="491" VPOS="2165" WIDTH="2795" HEIGHT="187"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b15" HPOS="498" VPOS="2311" WIDTH="2770" HEIGHT="174">
          <TextLine ID="l15" HPOS="498" VPOS="2311" WIDTH="2770" HEIGHT="174">
            <String ID="s15" CONTENT="d̶ redt durch euch / Euch w͛t an d̶ weil geg das ir solt" HPOS="498" VPOS="2311" WIDTH="2770" HEIGHT="174"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b16" HPOS="501" VPOS="2442" WIDTH="2776" HEIGHT="177">
          <TextLine ID="l16" HPOS="501" VPOS="2442" WIDTH="2776" HEIGHT="177">
            <String ID="s16" CONTENT="rede d̄ vnd d̄ v̈rett den vnd d̄ vat͛ den son vnd" HPOS="501" VPOS="2442" WIDTH="2776" HEIGHT="177"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b17" HPOS="501" VPOS="2582" WIDTH="2776" HEIGHT="202">
          <TextLine ID="l17" HPOS="501" VPOS="2582" WIDTH="2776" HEIGHT="202">
            <String ID="s17" CONTENT="steut dy kind͛ wid͛ den vat͛ und preugēt sy zu dē tot" HPOS="501" VPOS="2582" WIDTH="2776" HEIGHT="202"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b18" HPOS="473" VPOS="2725" WIDTH="2807" HEIGHT="218">
          <TextLine ID="l18" HPOS="473" VPOS="2725" WIDTH="2807" HEIGHT="218">
            <String ID="s18" CONTENT="vnd w͛den allē lewtē zu haꝫz durch meyñe nam d̶ ew̄r" HPOS="473" VPOS="2725" WIDTH="2807" HEIGHT="218"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b19" HPOS="488" VPOS="2877" WIDTH="1634" HEIGHT="199">
          <TextLine ID="l19" HPOS="488" VPOS="2877" WIDTH="1634" HEIGHT="199">
            <String ID="s19" CONTENT="bestet uff das ende d̶ ist selig." HPOS="488" VPOS="2877" WIDTH="1634" HEIGHT="199"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b20" HPOS="432" VPOS="3017" WIDTH="875" HEIGHT="143">
          <TextLine ID="l20" HPOS="432" VPOS="3017" WIDTH="875" HEIGHT="143">
            <String ID="s20" CONTENT="in die unius apostoli" HPOS="432" VPOS="3017" WIDTH="875" HEIGHT="143"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b21" HPOS="662" VPOS="3142" WIDTH="2659" HEIGHT="211">
          <TextLine ID="l21" HPOS="662" VPOS="3142" WIDTH="2659" HEIGHT="211">
            <String ID="s21" CONTENT="huͤs sp͛ch zu sein jnngn̄ / das gepot gib ich euch das" HPOS="662" VPOS="3142" WIDTH="2659" HEIGHT="211"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b22" HPOS="544" VPOS="3297" WIDTH="2829" HEIGHT="196">
          <TextLine ID="l22" HPOS="544" VPOS="3297" WIDTH="2829" HEIGHT="196">
            <String ID="s22" CONTENT="yr ane nand͛ lip habt / ap̄ euch dy wlt hasset / so wisset" HPOS="544" VPOS="3297" WIDTH="2829" HEIGHT="196"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b23" HPOS="498" VPOS="3428" WIDTH="2910" HEIGHT="218">
          <TextLine ID="l23" HPOS="498" VPOS="3428" WIDTH="2910" HEIGHT="218">
            <String ID="s23" CONTENT="das sy mich ee gehast hat · ap yr vō d̄ w̶l̶e̶ ̶w̶e̶r̶ ̶g̶e̶w̶e̶s̶n̶" HPOS="498" VPOS="3428" WIDTH="2910" HEIGHT="218"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b24" HPOS="507" VPOS="3571" WIDTH="2829" HEIGHT="193">
          <TextLine ID="l24" HPOS="507" VPOS="3571" WIDTH="2829" HEIGHT="193">
            <String ID="s24" CONTENT="so hett dy w̾lt lip · das ir were ouch seyt ir nicht d̶w̾lt" HPOS="507" VPOS="3571" WIDTH="2829" HEIGHT="193"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b25" HPOS="491" VPOS="3702" WIDTH="2910" HEIGHT="202">
          <TextLine ID="l25" HPOS="491" VPOS="3702" WIDTH="2910" HEIGHT="202">
            <String ID="s25" CONTENT="wenn ich han euch derwebt vō d͛ wlt gedenkt mir in" HPOS="491" VPOS="3702" WIDTH="2910" HEIGHT="202"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b26" HPOS="469" VPOS="3851" WIDTH="2855" HEIGHT="187">
          <TextLine ID="l26" HPOS="469" VPOS="3851" WIDTH="2855" HEIGHT="187">
            <String ID="s26" CONTENT="wort dy ich euch gesprochñ han d͛ knecht ist nicht" HPOS="469" VPOS="3851" WIDTH="2855" HEIGHT="187"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b27" HPOS="463" VPOS="3988" WIDTH="2882" HEIGHT="224">
          <TextLine ID="l27" HPOS="463" VPOS="3988" WIDTH="2882" HEIGHT="224">
            <String ID="s27" CONTENT="mer denn d̄ h͛r / ap sy mein geachteut habē . so achtēs" HPOS="463" VPOS="3988" WIDTH="2882" HEIGHT="224"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b28" HPOS="498" VPOS="4122" WIDTH="2798" HEIGHT="202">
          <TextLine ID="l28" HPOS="498" VPOS="4122" WIDTH="2798" HEIGHT="202">
            <String ID="s28" CONTENT="ouch ew͛r / ap sy meine wort behaltēt / so behaltens" HPOS="498" VPOS="4122" WIDTH="2798" HEIGHT="202"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b29" HPOS="485" VPOS="4271" WIDTH="2758" HEIGHT="181">
          <TextLine ID="l29" HPOS="485" VPOS="4271" WIDTH="2758" HEIGHT="181">
            <String ID="s29" CONTENT="ouch dy ewen̄ / das tuͦn sy ouch durch meinē willen" HPOS="485" VPOS="4271" WIDTH="2758" HEIGHT="181"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b30" HPOS="482" VPOS="4405" WIDTH="2907" HEIGHT="187">
          <TextLine ID="l30" HPOS="482" VPOS="4405" WIDTH="2907" HEIGHT="187">
            <String ID="s30" CONTENT="wen̄ sy erchantē jn nicht d̄ mich do sant · und wer" HPOS="482" VPOS="4405" WIDTH="2907" HEIGHT="187"/>
          </TextLine>
        </TextBlock>
        <TextBlock ID="b31" HPOS="491" VPOS="4539" WIDTH="2814" HEIGHT="249">
          <TextLine ID="l31" HPOS="491" VPOS="4539" WIDTH="2814" HEIGHT="249">
            <String ID="s31" CONTENT="ich nicht komē und hett yus nicht gesagt so hettn̄ sy" HPOS="491" VPOS="4539" WIDTH="2814" HEIGHT="249"/>
          </TextLine>
        </TextBlock>
