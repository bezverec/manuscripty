  "passages": [
    {
      "id": "u_15r_001",
      "title": "Úsek 1",
      "line_ids": [
        "f15r_l001",
        "f15r_l002",
        "f15r_l003",
        "f15r_l004",
        "f15r_l005",
        "f15r_l006",
        "f15r_l007",
        "f15r_l008"
      ],
      "latin": "[číslování i–v, částečně mimo segmentaci] Membra Christi. Membra ecclesiae triumphantis. Membra ecclesiae militantis. Membra diaboli. Membra inferni. Membra Christi.",
      "czech": "[Číslování i–v, částečně mimo segmentaci.] Členy vztahující se ke Kristu; k církvi vítězné; k církvi bojující; k ďáblovi; k peklu. Členy vztahující se ke Kristu.",
      "notes": "Tabulkový seznam pěti skupin, po němž začíná slovník první skupiny. Membra zde znamená kazatelské členy či výrazy, nikoli jen fyzické údy. Segmenty1–2 jsou pouze poslední číslice seznamu.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15r_002",
      "title": "Úsek 2",
      "line_ids": [
        "f15r_l009",
        "f15r_l010",
        "f15r_l011",
        "f15r_l012",
        "f15r_l013",
        "f15r_l014",
        "f15r_l015",
        "f15r_l016",
        "f15r_l017",
        "f15r_l018",
        "f15r_l019",
        "f15r_l020"
      ],
      "latin": "Omnipotens. [Unipotens?] Solipotens. Multipotens. Creator. Redemptor. Resuscitator. Retributor. Minister. Illuminator. [Clarificator?] Aeternator.",
      "czech": "Všemohoucí. [Mající jednu moc?] Jediný mocný. Mnohonásobně mocný. Stvořitel. Vykupitel. Křísitel. Odplatitel. Služebník. Osvětitel. [Oslavovatel?] Ten, kdo činí věčným.",
      "notes": "Hesla jsou v levém sloupci seskupena po čtyřech. Druhé heslo a clarificator vyžadují kontrolu; neopravuji je jen podle očekávaného teologického seznamu. Neobvyklé složeniny překládám popisně.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15r_003",
      "title": "Úsek 3",
      "line_ids": [
        "f15r_l021",
        "f15r_l022",
        "f15r_l023",
        "f15r_l024",
        "f15r_l025",
        "f15r_l026",
        "f15r_l027",
        "f15r_l028",
        "f15r_l029",
        "f15r_l030",
        "f15r_l031",
        "f15r_l032"
      ],
      "latin": "Trinitas. Unitas. Maiestas. Potestas. Solus. Iustus. Rectus. Pius. Fortis. Mirabilis. Suavis. Delectabilis.",
      "czech": "Trojice. Jednota. Velebnost. Moc. Jediný. Spravedlivý. Přímý. Milostivý. Silný. Podivuhodný. Líbezný. Příjemný.",
      "notes": "Tři následující čtveřice levého sloupce. Hesla nejsou souvislá věta ani nové vyprávění. Suavis je z obrazu čitelnější než modelové Quams.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15r_004",
      "title": "Úsek 4",
      "line_ids": [
        "f15r_l033",
        "f15r_l034",
        "f15r_l035",
        "f15r_l036",
        "f15r_l037",
        "f15r_l038",
        "f15r_l039",
        "f15r_l040",
        "f15r_l041",
        "f15r_l042",
        "f15r_l043",
        "f15r_l044"
      ],
      "latin": "[Illocabilis?] Intemporalis. Interminabilis. Inexplicabilis. Iesus. Christus. Dominus. Deus. Immutabilis. Ineffabilis. Incomprehensibilis. Inaestimabilis.",
      "czech": "[Neumístitelný do prostoru?] Mimo čas. Bez hranic. Nevysvětlitelný. Ježíš. Kristus. Pán. Bůh. Neměnný. Nevyslovitelný. Nepochopitelný. Neocenitelný.",
      "notes": "Začátek pravého sloupce. První heslo je graficky nejisté a jeho český význam pouze návrhový. Tvar zkratky Christus je rozveden návrhově, raw modelu zůstává oddělen.",
      "operations": [],
      "language": "la"
    },
    {
      "id": "u_15r_005",
      "title": "Úsek 5",
      "line_ids": [
        "f15r_l045",
        "f15r_l046",
        "f15r_l047",
