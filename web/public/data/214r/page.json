t_ids":["f214r_l108"],"bbox":[2422,4757,1465,168],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/214r/f214r_l108.webp","raw_htr":{"catmus":"Oseca agitur de offectoro ubi ista","medusa":"Oseca agitur de offerorio ubi ista"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f214r_l109","source_segment_ids":["f214r_l109"],"bbox":[2406,4867,464,110],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/214r/f214r_l109.webp","raw_htr":{"catmus":"snotantut","medusa":"notantur"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f214r_l110","source_segment_ids":["f214r_l110"],"bbox":[2348,4941,1300,138],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/214r/f214r_l110.webp","raw_htr":{"catmus":"pͥmo qr sauit⁊ post sibolũ","medusa":"primo qr sequitur post symbolum"},"words":[],"flags":[],"note":null,"hit_token_limit":false},{"id":"f214r_l111","source_segment_ids":["f214r_l111"],"bbox":[2321,5032,1475,198],"image":"https://rukopisy-data.digitalizaty.cz/v1/crops/214r/f214r_l111.webp","raw_htr":{"catmus":"Quae salutaco p̃miltil ⁊ qr diͬ or̃o","medusa":"Quae salutacio permittit et qur dicitur oratio"},"words":[],"flags":[],"note":null,"hit_token_limit":false}],"passages":[{"id":"f214r_p01","title":"Aleluja a traktus","line_ids":["f214r_l001","f214r_l002","f214r_l003","f214r_l004","f214r_l005","f214r_l006","f214r_l007","f214r_l008"],"latin":"Quare Alleluia repetitur. Quare tempore Paschali geminatur. Quare tunc responsorium Haec dies dicitur. Quare aliquando non cantatur. Post agitur de tractu. Primo de eius ordine. Secundo quid significat. Tertio quare sic vocatur.","czech":"Proč se aleluja opakuje, proč se ve velikonoční době zdvojuje, proč se tehdy říká responsorium Haec dies a proč se někdy nezpívá. Poté o traktu: nejprve o jeho pořadí, zadruhé co znamená a zatřetí proč se tak nazývá.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p02","title":"Evangelium a služba jáhna","line_ids":["f214r_l009","f214r_l010","f214r_l011","f214r_l012","f214r_l013","f214r_l014","f214r_l015","f214r_l016","f214r_l017","f214r_l018","f214r_l019","f214r_l020","f214r_l021","f214r_l022","f214r_l023","f214r_l024","f214r_l025"],"latin":"Postea agitur de evangelio. Primo quis sit minister eius. Quomodo debet librum recipere; debet portare minister. Qualiter debet incedere. Quare tot vadunt cum diacono. Postea quomodo debet facere, quomodo debet populum salutare, quomodo debet thurificare. Quomodo debet signare. Ubi evangelium debet cantari; quomodo debet cantari. Qualiter debet intitulari, quid debet ⟦reddi?⟧. Quid debent facere audientes evangelium, et ponuntur ibi quinque quae facere debent. Postea agitur quod diaconus debet librum reportare evangelio dicto. Postea librum apertum tradere sacerdoti ad osculum.","czech":"Poté o evangeliu: kdo je jeho služebníkem, jak má přijmout a nést knihu, jak má kráčet a proč jde s jáhnem tolik lidí. Jak má jednat, pozdravit lid, okuřovat a žehnat znamením kříže; kde a jak se má evangelium zpívat, jak má být uvedeno a co se má ⟦odpovědět?⟧. Co mají dělat posluchači evangelia; uvádí se pět povinností. Poté že jáhen má po evangeliu odnést knihu a otevřenou ji podat knězi k políbení.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p03","title":"Vyznání víry","line_ids":["f214r_l026","f214r_l027","f214r_l028","f214r_l029","f214r_l030","f214r_l031","f214r_l032","f214r_l033","f214r_l034","f214r_l035","f214r_l036","f214r_l037","f214r_l038","f214r_l039","f214r_l040","f214r_l041","f214r_l042","f214r_l043"],"latin":"Postea agitur de symbolo vel Credo. Primo quare post evangelium sequitur. Quare sacerdos ipsum incipit. Quare fides est nobis necessaria, et dicendum propter quatuor rationes pulcherrimas. Nota ibi multa posita: quid est articulus, et quare sic dicitur, et quot modis dicitur articulus. Quid est symbolum. Quae necessitas inveniendi symbolum. Quare variis modis dicitur. Qualiter apostoli fecerunt ipsum. Postea sufficientia articulorum. Postea sequitur expositio illius sigillatim et ponuntur omnes errores qui fuerunt contra articulos. Postea quodlibet unum trahitur ad instructionem nostram diffuse.","czech":"Poté o vyznání víry čili Credo: proč následuje po evangeliu a proč je začíná kněz. Proč potřebujeme víru; mají být řečeny čtyři krásné důvody. Dále co je článek, proč se tak nazývá a kolika způsoby se tento název užívá; co je symbolum, proč bylo nutné je vytvořit, proč se říká různými způsoby a jak je vytvořili apoštolové. Poté o dostatečnosti článků. Následuje výklad každého jednotlivě i všechny omyly proti článkům; každý se podrobně vztahuje k našemu poučení.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p04","title":"Témata jednotlivých článků","line_ids":["f214r_l044","f214r_l045","f214r_l046","f214r_l047","f214r_l048","f214r_l049","f214r_l050","f214r_l051","f214r_l052","f214r_l053","f214r_l054","f214r_l055","f214r_l056","f214r_l057"],"latin":"Et nota ibi multa quomodo ⟦virgo gignit et aperte?⟧. Item quae necessitas patiendi Christum. Item Christus descendit ad inferos propter quatuor rationes. Qualiter non distulit resurgere usque in finem. Item de iudicio et qui sunt iudicandi et quomodo iudicabunt aliqui diversimode. Item quod ecclesia dicitur sancta, katholica et apostolica. Item de baptismo et eius mysterio et eius effectu et materia eius. Item de gloria et vita aeterna; vide ibi mirabilia iuxta singulos articulos.","czech":"Dále mnoho o tom, jak ⟦panna rodí a zjevně?⟧; jaká byla nutnost Kristova utrpení, o čtyřech důvodech Kristova sestupu do podsvětí a proč neodložil vzkříšení až na konec. O soudu, kdo bude souzen a jak budou někteří soudit různými způsoby. Proč se církev nazývá svatá, katolická a apoštolská. O křtu, jeho tajemství, účinku a látce; o slávě a věčném životě. Viz tam podivuhodné věci u jednotlivých článků.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p05","title":"Bůh a vtělení","line_ids":["f214r_l058","f214r_l059","f214r_l060","f214r_l061","f214r_l062","f214r_l063","f214r_l064","f214r_l065","f214r_l066"],"latin":"Postea circa articulos moventur quaestiones. Utrum sit unus Deus. Item quare iste ponitur inter articulos. Item quare fuerunt inducti homines ad ponendum plures deos. Item utrum Filius fuisset incarnatus si Adam non peccasset. Postea quomodo Christus mortuus est cum esset Deus.","czech":"Poté se kladou otázky k článkům: zda je jediný Bůh a proč je tato otázka mezi články; proč byli lidé přivedeni k uznávání více bohů. Zda by se Syn vtělil, kdyby Adam nezhřešil. Poté jak Kristus zemřel, když byl Bohem.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p06","title":"Podsvětí a očistec","line_ids":["f214r_l067","f214r_l068","f214r_l069","f214r_l070","f214r_l071","f214r_l072","f214r_l073","f214r_l074","f214r_l075","f214r_l076","f214r_l077","f214r_l078","f214r_l079","f214r_l080"],"latin":"Circa articulum de ⟦descensu?⟧ quaeritur utrum infernus sit sub terra. Utrum infernus et purgatorium sint idem. Utrum infernus et limbus sint idem. Utrum limbus et sinus Abrahae sint idem. Utrum limbus patrum et puerorum sint idem. Utrum receptacula distinguantur. Utrum Christus descendit ad infernum damnatorum. Utrum ibi moram traxerit. Utrum omnes de purgatorio extraxit. Utrum ignis inferni sit corporeus. Utrum sit eiusdem speciei cum igne nostro. Utrum damnati possint exire.","czech":"U článku o ⟦sestupu?⟧ se táže, zda je peklo pod zemí, zda je peklo a očistec totéž, zda je peklo a limbus totéž a zda je limbus totožný s lůnem Abrahamovým. Zda je limbus otců a dětí totéž a zda se místa pobytu rozlišují. Zda Kristus sestoupil do pekla zavržených, zda tam prodléval a zda vyvedl všechny z očistce. Zda je pekelný oheň tělesný a stejného druhu jako náš; zda zavržení mohou vyjít.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p07","title":"Vzkříšení Krista a poslední soud","line_ids":["f214r_l081","f214r_l082","f214r_l083","f214r_l084","f214r_l085","f214r_l086","f214r_l087","f214r_l088","f214r_l089","f214r_l090","f214r_l091","f214r_l092","f214r_l093"],"latin":"Postea utrum Christus resurrexit cum cicatricibus. Postea utrum ascendit super omnes caelos. Postea utrum generale iudicium sit futurum. Utrum sit vocale vel mentale. Postea de tempore iudicii. Postea de loco. Utrum omnes videant bona et mala propria. Utrum omnia aliorum. Utrum Christus iudicet in forma humana. Utrum in forma gloriosa. Utrum solus iudicet. Postea utrum baptismus tollat omnem ⟦inutilitatem?⟧.","czech":"Poté zda Kristus vstal z mrtvých s jizvami a zda vystoupil nad všechna nebesa. Zda bude obecný soud a zda bude hlasitý, nebo v mysli; dále o jeho době a místě. Zda všichni uvidí vlastní dobré a zlé skutky a všechny skutky ostatních. Zda Kristus soudí v lidské podobě, zda ve slavné podobě a zda soudí sám. Poté zda křest odstraňuje veškerou ⟦neužitečnost?⟧.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p08","title":"Vzkříšení těl","line_ids":["f214r_l094","f214r_l095","f214r_l096","f214r_l097","f214r_l098","f214r_l099","f214r_l100","f214r_l101","f214r_l102","f214r_l103","f214r_l104","f214r_l105","f214r_l106","f214r_l107"],"latin":"Postea de resurrectione. Utrum idem corpus resurgat. Utrum omnia membra resurgant. Utrum partes redeant ad locum eundem. Utrum omnes homines resurgant. Utrum pili et ungues. Utrum quae omnia fuerunt de veritate naturae. In qua aetate resurgent. In qua statura. In quo sexu. Utrum damnati resurgent cum deformitatibus. Utrum corpora eorum sint corruptibilia. Utrum sint impassibilia.","czech":"Poté o vzkříšení: zda vstane totéž tělo, všechny údy a zda se části vrátí na totéž místo. Zda vstanou všichni lidé, vlasy a nehty i vše, co náleželo k pravé přirozenosti. V jakém věku, vzrůstu a pohlaví vstanou. Zda zavržení vstanou se znetvořeními a zda budou jejich těla porušitelná a neschopná trpět.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]},{"id":"f214r_p09","title":"Začátek otázek k offertoriu","line_ids":["f214r_l108","f214r_l109","f214r_l110","f214r_l111"],"latin":"Postea agitur de offertorio, ubi ista notantur. Primo quare sequitur post symbolum. Quare salutatio praemittitur et quare dicitur Oremus.","czech":"Poté o offertoriu a těchto otázkách: proč následuje po vyznání víry, proč se před ním pozdravuje a říká Oremus.","notes":"Čtení ověřováno na nativních pásech proti oběma raw HTR; označená místa zůstávají nejistá.","operations":[]}],"preview":"https://rukopisy-data.digitalizaty.cz/v1/previews/214r.webp","tiles":{"type":"dzi","width":4500,"height":5900,"tileSize":512,"tileOverlap":1,"tilesUrl":"https://rukopisy-data.digitalizaty.cz/v1/tiles/214r/","fileFormat":"webp"},"blank":false,"source_original":"EX/M_II_220____26LY4SCEX0214R.TIF","expert_review":false,"downloads":[{"name":"Neupravené HTR a geometrie JSON","href":"data/214r/comparison.json"},{"name":"Rekonstrukce a překlad JSON","href":"data/214r/reconstruction.json"},{"name":"TEI P5 4.12.0","href":"data/214r/reconstruction.tei.xml"},{"name":"Latinská rekonstrukce TXT","href":"data/214r/reconstruction.la.txt"},{"name":"Český překlad TXT","href":"data/214r/translation.cs.txt"}],"document_id":"vkol-m-ii-220","document_uri":"https://rukopisy.digitalizaty.cz/rukopisy/vkol-m-ii-220","repository":{"name":"Vědecká knihovna v Olomouci","uri":"https://www.vkol.cz/","settlement":"Olomouc","country":"Česko"}}
